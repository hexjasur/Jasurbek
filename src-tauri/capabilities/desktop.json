{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only permissions for the update window",
  "windows": [
    "main",
    "updater"
  ],
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-close",
    "window-state:default"
  ]
}
