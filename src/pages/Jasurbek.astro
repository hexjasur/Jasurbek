---
import { BASE_URL } from '../lib/url';
const target = BASE_URL;
---
<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0;url=${target}`} />
  <link rel="canonical" href={target} />
  <title>Redirecting to Home...</title>
</head>
<body>
  <p>Redirecting to <a href={target}>Home</a>...</p>
</body>
</html>
