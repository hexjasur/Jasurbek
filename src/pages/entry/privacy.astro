---
import { BASE_URL } from '../../lib/url';
const target = `${BASE_URL}entry/privacy_policy/`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0;url=${target}`} />
  <link rel="canonical" href={target} />
  <title>Redirecting to Privacy Policy...</title>
</head>
<body>
  <p>Redirecting to <a href={target}>Privacy Policy</a>...</p>
</body>
</html>
