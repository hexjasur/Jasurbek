---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config';

const formId = SITE_CONFIG.formspreeFormId.trim();
const formReady = formId.length > 0;
const turnstileSiteKey = SITE_CONFIG.turnstileSiteKey.trim();
---

<Layout
  title={`Contact | ${SITE_CONFIG.author}`}
  description={`Get in touch with ${SITE_CONFIG.author} about software projects, collaboration, or work opportunities.`}
  activePage="contact"
  headerTitle={`Contact ${SITE_CONFIG.author}`}
>
  <section class="contact-intro">
    <p class="eyebrow">Get in touch</p>
    <h2>Have a project or idea?</h2>
    <p>
      Send a message about a project, collaboration, or work opportunity. You can also reach me directly by email or Telegram.
    </p>
  </section>

  <section class="contact-card contact-form-card" aria-labelledby="contact-form-title">
    <h3 id="contact-form-title">Send a message</h3>
    {!formReady && (
      <p class="form-setup-note" role="status">
        The contact form is ready to connect. Add your Formspree form ID in <code>src/config.ts</code> to enable submissions.
      </p>
    )}
    {formReady && !turnstileSiteKey && (
      <p class="form-setup-note" role="status">
        Add a Cloudflare Turnstile site key in <code>src/config.ts</code> and enable Turnstile in your Formspree form settings to protect this form from spam.
      </p>
    )}
    <form
      class="contact-form"
      data-contact-form
      data-turnstile-sitekey={turnstileSiteKey}
      action={formReady ? `https://formspree.io/f/${formId}` : undefined}
      method="POST"
    >
      <fieldset disabled={!formReady}>
        <label>
          <span class="field-label">Email address</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>
          <span class="field-label">Message</span>
          <textarea name="message" rows="6" required></textarea>
        </label>
        {turnstileSiteKey && <div class="turnstile-widget" data-turnstile-widget></div>}
        <input type="hidden" name="_subject" value="New message from Jasurbek's portfolio" />
        <div class="contact-honeypot" aria-hidden="true">
          <label>
            Leave this field empty
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </label>
        </div>
        <button class="btn" type="submit">Send message</button>
      </fieldset>
      <p class="form-feedback" data-form-status role="status" aria-live="polite" hidden></p>
    </form>
  </section>
</Layout>

<script>
  interface TurnstileApi {
    render: (
      container: HTMLElement,
      options: {
        sitekey: string;
        size: 'flexible' | 'compact';
        callback: () => void;
        'expired-callback': () => void;
        'error-callback': () => void;
      },
    ) => string;
    reset: (widgetId: string) => void;
  }

  declare global {
    interface Window {
      turnstile?: TurnstileApi;
    }
  }

  let turnstileLoader: Promise<void> | undefined;

  function loadTurnstile(): Promise<void> {
    if (window.turnstile) return Promise.resolve();
    if (turnstileLoader) return turnstileLoader;

    turnstileLoader = new Promise((resolve, reject) => {
      let script = document.querySelector<HTMLScriptElement>('#cloudflare-turnstile-script');
      if (!script) {
        script = document.createElement('script');
        script.id = 'cloudflare-turnstile-script';
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        script.async = true;
        script.defer = true;
        document.head.append(script);
      }

      script.addEventListener('load', () => resolve(), { once: true });
      script.addEventListener('error', () => reject(new Error('Cloudflare Turnstile failed to load.')), { once: true });
    });

    return turnstileLoader;
  }

  function setupContactForm() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = 'true';

    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const widgetContainer = form.querySelector<HTMLElement>('[data-turnstile-widget]');
    const siteKey = form.dataset.turnstileSitekey;
    if (!status || !submitButton) return;

    let widgetId: string | undefined;
    if (siteKey && widgetContainer) {
      submitButton.disabled = true;
      loadTurnstile()
        .then(() => {
          if (!window.turnstile || !widgetContainer.isConnected) return;
          widgetId = window.turnstile.render(widgetContainer, {
            sitekey: siteKey,
            size: widgetContainer.clientWidth < 300 ? 'compact' : 'flexible',
            callback: () => {
              submitButton.disabled = false;
              status.hidden = true;
            },
            'expired-callback': () => {
              submitButton.disabled = true;
              status.hidden = false;
              status.dataset.state = 'error';
              status.textContent = 'Verification expired. Please complete the check again.';
            },
            'error-callback': () => {
              submitButton.disabled = true;
              status.hidden = false;
              status.dataset.state = 'error';
              status.textContent = 'Verification could not be completed. Please refresh the page and try again.';
            },
          });
        })
        .catch((error: unknown) => {
          console.error('Unable to load Cloudflare Turnstile.', error);
          status.hidden = false;
          status.dataset.state = 'error';
          status.textContent = 'Spam protection could not be loaded. Please refresh the page and try again.';
        });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      if (siteKey && !new FormData(form).get('cf-turnstile-response')) {
        status.hidden = false;
        status.dataset.state = 'error';
        status.textContent = 'Please complete the anti-spam check before sending your message.';
        return;
      }

      submitButton.disabled = true;
      status.hidden = false;
      status.dataset.state = 'sending';
      status.textContent = 'Sending your message…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) {
          throw new Error(`Form submission failed with status ${response.status}`);
        }

        form.reset();
        status.dataset.state = 'success';
        status.textContent = 'Thanks! Your message has been sent.';
      } catch (error) {
        console.error('Unable to submit the contact form.', error);
        status.dataset.state = 'error';
        status.textContent = 'Your message could not be sent. Please try again or contact me by email.';
      } finally {
        if (siteKey && widgetId && window.turnstile) {
          window.turnstile.reset(widgetId);
          submitButton.disabled = true;
        } else {
          submitButton.disabled = false;
        }
      }
    });
  }

  document.addEventListener('astro:page-load', setupContactForm);
  setupContactForm();
</script>
