---
import Layout from '../../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../../config';
import { BASE_URL as baseUrl } from '../../../lib/url';
import { getTagMap } from '../../../lib/blog';

const tagMap = await getTagMap();
const tags = [...tagMap.entries()].sort(
  (a, b) => b[1].posts.length - a[1].posts.length || a[1].label.localeCompare(b[1].label),
);

// Primary sections. Every post in them also keeps its own topic tags.
// Tag slugs here must stay in sync with the `tags` frontmatter of posts.
const mainSections = [
  { slug: 'windows', title: 'Windows' },
  { slug: 'claude-ai', title: 'Claude & AI' },
  { slug: 'soliq', title: 'Uzbek tax (soliq)' },
  { slug: 'tauri-frontend', title: 'Tauri & frontend' },
];
---

<Layout
  title={`Blog Tags | ${SITE_CONFIG.author}`}
  description="Browse all topics covered on the blog: web development, tooling, AI agents, desktop and mobile apps, and the Uzbek alphabet."
  activePage="blog"
  searchable={false}
  headerTitle={SITE_CONFIG.domain}
>
  <div class="back-link-wrap">
    <a href={`${baseUrl}blog`} class="back-link">&larr; Back to all blog entries</a>
  </div>

  <h2 class="page-title">Browse by tag</h2>
  <p class="page-lead">{tags.length} topics across the blog.</p>

  <h3 class="page-lead">Main sections</h3>
  <ul class="tag-cloud">
    {mainSections.map(({ slug, title }) => {
      const entry = tagMap.get(slug);
      return entry ? (
        <li>
          <a class="tag-badge" href={`${baseUrl}blog/tags/${slug}`}>
            {title} <span class="tag-count">{entry.posts.length}</span>
          </a>
        </li>
      ) : null;
    })}
  </ul>

  <h3 class="page-lead">All tags</h3>
  <ul class="tag-cloud">
    {tags.map(([slug, { label, posts }]) => (
      <li>
        <a class="tag-badge" href={`${baseUrl}blog/tags/${slug}`}>
          #{label} <span class="tag-count">{posts.length}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
