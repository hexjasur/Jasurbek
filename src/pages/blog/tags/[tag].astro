---
import Layout from '../../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../../config';
import { BASE_URL as baseUrl } from '../../../lib/url';
import { getTagMap } from '../../../lib/blog';

export async function getStaticPaths() {
  const tags = await getTagMap();
  return [...tags.entries()].map(([slug, { label, posts }]) => ({
    params: { tag: slug },
    props: { label, posts },
  }));
}

const { label, posts } = Astro.props;
---

<Layout
  title={`Posts tagged #${label} | ${SITE_CONFIG.author}`}
  description={`${posts.length} ${posts.length === 1 ? 'article' : 'articles'} tagged ${label} on the blog of ${SITE_CONFIG.author}.`}
  activePage="blog"
  headerTitle={SITE_CONFIG.domain}
>
  <div class="back-link-wrap">
    <a href={`${baseUrl}blog/tags`} class="back-link">&larr; All tags</a>
  </div>

  <h2 class="page-title">Tagged #{label}</h2>
  <p class="page-lead">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>

  <div class="blog-grid">
    {posts.map((post) => (
      <article class="blog-card">
        <div class="blog-card-header">
          <a href={`${baseUrl}blog/${post.id}`}>{post.data.title}</a>
        </div>
        <p class="card-desc">{post.data.description}</p>
      </article>
    ))}
  </div>
</Layout>
