---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { SITE_CONFIG } from '../../config';
import { absoluteUrl } from '../../lib/url';
import { blogPostingSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

const postSchema = blogPostingSchema({
  title: post.data.title,
  description: post.data.description,
  url: absoluteUrl(`blog/${post.id}/`),
  image: absoluteUrl(`og/blog/${post.id}.png`),
  datePublished: post.data.pubDate,
  tags: post.data.tags,
});
---

<Layout 
  title={`${post.data.title} | ${SITE_CONFIG.author}`} 
  description={post.data.description}
  activePage="blog"
  headerTitle={SITE_CONFIG.domain}
  type="article"
  publishedTime={post.data.pubDate}
  tags={post.data.tags}
  schema={postSchema}
>
  <div class="back-link-wrap">
    <a href={`${baseUrl}blog`} class="back-link">&larr; Back to all blog entries</a>
  </div>

  <article>
    <h1 class="post-title">
      {post.data.title}
    </h1>
    <div class="post-meta">
      Published on: {formattedDate}
    </div>

    {post.data.tags && (
      <div class="post-tags">
        {post.data.tags.map((tag: string) => (
          <span class="tag-badge">#{tag}</span>
        ))}
      </div>
    )}

    <div class="prose">
      <Content />
    </div>
  </article>

  <div class="page-footer-nav">
    <a href={`${baseUrl}blog`} class="back-link">&larr; Back to all blog entries</a>
  </div>
</Layout>
