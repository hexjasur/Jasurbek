---
import Layout from '../../layouts/Layout.astro';
import Toc from '../../components/Toc.astro';
import CodeCopy from '../../components/CodeCopy.astro';
import Comments from '../../components/Comments.astro';
import { render } from 'astro:content';
import { SITE_CONFIG } from '../../config';
import { absoluteUrl, BASE_URL as baseUrl } from '../../lib/url';
import { blogPostingSchema } from '../../lib/schema';
import { getSortedPosts, readingTime, formatDate, tagSlug } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // Posts are sorted newest first, so "older" is the next index.
      newer: index > 0 ? posts[index - 1] : undefined,
      older: index < posts.length - 1 ? posts[index + 1] : undefined,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);

const { pubDate, updatedDate } = post.data;
const formattedDate = formatDate(pubDate);
// Only show "Updated" when it falls on a different day than the publish date.
const dayOf = (d: Date | string) => new Date(d).toISOString().slice(0, 10);
const showUpdated = !!updatedDate && dayOf(updatedDate) !== dayOf(pubDate);
const updatedISO = showUpdated ? new Date(updatedDate).toISOString() : undefined;
const formattedUpdated = showUpdated ? formatDate(updatedDate) : undefined;
const minutes = readingTime(post.body);

const postSchema = blogPostingSchema({
  title: post.data.title,
  description: post.data.description,
  url: absoluteUrl(`blog/${post.id}/`),
  image: absoluteUrl(`og/blog/${post.id}.png`),
  datePublished: pubDate,
  dateModified: updatedDate,
  tags: post.data.tags,
});
---

<Layout
  title={`${post.data.title} | ${SITE_CONFIG.author}`}
  description={post.data.description}
  activePage="blog"
  headerTitle={SITE_CONFIG.domain}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={post.data.tags}
  schema={postSchema}
>
  <div class="back-link-wrap">
    <a href={`${baseUrl}blog`} class="back-link">&larr; Back to all blog entries</a>
  </div>

  <article>
    <h1 class="post-title">
      {post.data.title}
    </h1>
    <div class="post-meta">
      <div class="post-meta-line">
        <time datetime={new Date(pubDate).toISOString()}>Published on: {formattedDate}</time>
      </div>
      {formattedUpdated && (
        <div class="post-meta-line">
          <time datetime={updatedISO}>Updated on: {formattedUpdated}</time>
        </div>
      )}
      <div class="post-meta-line">{minutes} min read</div>
    </div>

    {post.data.tags && (
      <div class="post-tags">
        {post.data.tags.map((tag: string) => (
          <a class="tag-badge" href={`${baseUrl}blog/tags/${tagSlug(tag)}`}>#{tag}</a>
        ))}
      </div>
    )}

    <Toc headings={headings} />

    <div class="prose">
      <Content />
    </div>
  </article>

  {(newer || older) && (
    <nav class="post-nav" aria-label="More articles">
      {older ? (
        <a class="post-nav-link" rel="prev" href={`${baseUrl}blog/${older.id}`}>
          <span class="post-nav-label">&larr; Older</span>
          <span class="post-nav-title">{older.data.title}</span>
        </a>
      ) : <span />}
      {newer ? (
        <a class="post-nav-link post-nav-next" rel="next" href={`${baseUrl}blog/${newer.id}`}>
          <span class="post-nav-label">Newer &rarr;</span>
          <span class="post-nav-title">{newer.data.title}</span>
        </a>
      ) : <span />}
    </nav>
  )}

  <Comments />

  <div class="page-footer-nav">
    <a href={`${baseUrl}blog`} class="back-link">&larr; Back to all blog entries</a>
  </div>
  <CodeCopy />
</Layout>
