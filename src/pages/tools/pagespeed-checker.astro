---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config';
import { BASE_URL as baseUrl } from '../../lib/url';
import CustomSelect from '../../components/CustomSelect.astro';
---

<Layout
  title={`Website Speed & Performance Checker | ${SITE_CONFIG.author}`}
  description="Enter any website URL and jump straight to its Google PageSpeed Insights report: Core Web Vitals, performance score, and mobile or desktop analysis."
  activePage="tools"
  headerTitle={SITE_CONFIG.domain}
>
  <div class="back-link-wrap">
    <a href={`${baseUrl}tools`} class="back-link">&larr; Back to all tools</a>
  </div>

  <section class="tools-box">
    <h2 class="page-title">
      <svg
        class="title-svg"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 8v4l3 2"></path>
        <path d="M16.2 7.8 18 6"></path>
      </svg>
      Website Speed & Performance Checker
    </h2>
    <p class="page-lead">
      Paste a website URL below and hit Analyze — you'll be taken straight to
      its
      <strong>Google PageSpeed Insights</strong> report, with Core Web Vitals, a performance
      score, and tips for both mobile and desktop.
    </p>

    <div class="tools-row ps-input-row">
      <div class="ps-input-wrap">
        <input
          type="text"
          id="ps-url"
          class="tools-select ps-url-input"
          placeholder="example.com or https://example.com"
          value={SITE_CONFIG.siteUrl}
          autocomplete="url"
          inputmode="url"
          spellcheck="false"
        />
      </div>
    </div>

    <div class="tools-row ps-controls-row">
      <div class="ps-device-wrap">
        <label for="ps-strategy" class="field-label field-label-inline"
          >Device:</label
        >
        <CustomSelect
          id="ps-strategy"
          options={[
            { value: 'mobile', label: 'Mobile' },
            { value: 'desktop', label: 'Desktop' },
          ]}
          value="mobile"
          ariaLabel="Device"
        />
      </div>
      <button class="btn ps-analyze-btn" id="ps-analyze-btn" type="button"
        >Analyze on PageSpeed Insights &rarr;</button
      >
    </div>

    <p id="ps-error" class="error-text" hidden>
      Enter a valid website address, for example example.com or
      https://example.com.
    </p>

    <p class="page-lead" style="margin-top:1.5rem;">
      This opens Google's own PageSpeed Insights tool (pagespeed.web.dev) in a
      new tab and runs the audit there — nothing is sent anywhere else.
    </p>
  </section>

  <div class="page-footer-nav">
    <a href={`${baseUrl}tools`} class="back-link">&larr; Back to all tools</a>
  </div>
</Layout>

<script>
  function normalizeUrl(raw: string): string | null {
    const value = raw.trim();
    if (!value) return null;
    const withScheme = /^https?:\/\//i.test(value) ? value : `https://${value}`;
    try {
      const u = new URL(withScheme);
      if (!u.hostname.includes('.')) return null;
      return u.toString();
    } catch {
      return null;
    }
  }

  function setupPageSpeed() {
    const input = document.getElementById('ps-url') as HTMLInputElement | null;
    const strategyRoot =
      document
        .getElementById('ps-strategy')
        ?.closest<HTMLElement>('[data-custom-select]') ?? null;
    const btn = document.getElementById('ps-analyze-btn');
    const errorEl = document.getElementById('ps-error');
    if (!input || !strategyRoot || !btn || !errorEl) return;

    function go() {
      const normalized = normalizeUrl(input!.value);
      if (!normalized) {
        errorEl!.hidden = false;
        input!.focus();
        return;
      }
      errorEl!.hidden = true;
      const formFactor = strategyRoot!.dataset.value || 'mobile';
      const target = `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(normalized)}&form_factor=${formFactor}`;
      window.open(target, '_blank', 'noopener,noreferrer');
    }

    btn.addEventListener('click', go);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') go();
    });
    input.addEventListener('input', () => {
      errorEl!.hidden = true;
    });
  }

  document.addEventListener('astro:page-load', setupPageSpeed);
</script>

<style>
  .page-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .title-svg {
    width: 22px;
    height: 22px;
    color: var(--focus);
    flex-shrink: 0;
  }

  .ps-input-row {
    justify-content: center;
    margin-top: 1.5rem;
  }

  .ps-input-wrap {
    width: min(100%, 760px);
  }

  .ps-url-input {
    width: 100%;
    min-height: 3.1rem;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    border-color: var(--focus);
    box-shadow: 0 0 0 0 rgba(9, 105, 218, 0);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.02),
      rgba(255, 255, 255, 0.01)
    );
  }

  .ps-url-input:focus {
    outline: none;
    border-color: var(--focus);
    box-shadow: 0 0 0 4px rgba(9, 105, 218, 0.12);
    transform: translateY(-1px);
  }

  .ps-controls-row {
    justify-content: center;
    align-items: center;
    margin-top: 1.25rem;
    gap: 1rem;
  }

  .ps-device-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0.65rem 0.3rem 0.3rem;
    border: 1px solid var(--line-soft);
    border-radius: 10px;
    background: var(--surface-2);
  }

  .ps-analyze-btn {
    min-height: 2.9rem;
    border-radius: 10px;
    box-shadow: 0 8px 18px rgba(25, 30, 35, 0.12);
  }

  @media (max-width: 640px) {
    .ps-controls-row {
      flex-direction: column;
      align-items: stretch;
    }

    .ps-device-wrap {
      justify-content: center;
      width: 100%;
    }

    .ps-analyze-btn {
      width: 100%;
    }
  }
</style>
