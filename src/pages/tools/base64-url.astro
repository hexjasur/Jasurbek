---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config';
import { BASE_URL as baseUrl } from '../../lib/url';
---

<Layout
  title={`Base64 & URL Encoder / Decoder | ${SITE_CONFIG.author}`}
  description="Encode and decode Base64, Base64URL and URL components with full UTF-8 support, including Uzbek letters. Everything runs in your browser."
  activePage="tools"
  headerTitle={SITE_CONFIG.domain}
>
  <div class="back-link-wrap">
    <a href={`${baseUrl}tools`} class="back-link">&larr; Back to all tools</a>
  </div>

  <section class="tools-box">
    <h2 class="page-title">🔐 Base64 &amp; URL Encoder / Decoder</h2>
    <p class="page-lead">
      Convert text to and from Base64, URL-safe Base64 (Base64URL, used in JWTs) and percent-encoded URL components.
      Unicode is handled correctly, so text like <code>O'zbek tili: ö ğ ş ç</code> round-trips safely.
    </p>

    <div class="tools-row">
      <div>
        <label for="b64-mode" class="field-label field-label-inline">Format:</label>
        <select id="b64-mode" class="tools-select">
          <option value="base64">Base64</option>
          <option value="base64url">Base64URL (URL-safe, no padding)</option>
          <option value="url">URL component (percent-encoding)</option>
        </select>
      </div>
      <div>
        <label for="b64-dir" class="field-label field-label-inline">Direction:</label>
        <select id="b64-dir" class="tools-select">
          <option value="encode">Encode</option>
          <option value="decode">Decode</option>
        </select>
      </div>
    </div>

    <div class="converter-split">
      <div>
        <label for="b64-input" class="field-label field-label-block">Input:</label>
        <textarea id="b64-input" spellcheck="false" placeholder="Type or paste text here..."></textarea>
      </div>
      <div>
        <label for="b64-output" class="field-label field-label-block">Output:</label>
        <textarea id="b64-output" readonly spellcheck="false" placeholder="Result appears here..."></textarea>
      </div>
    </div>

    <p id="b64-error" class="error-text" role="alert" hidden></p>

    <div class="tools-buttons">
      <button class="btn" id="b64-copy-btn" type="button">Copy Output</button>
      <button class="btn btn-secondary" id="b64-swap-btn" type="button">Use output as input</button>
      <button class="btn btn-secondary" id="b64-clear-btn" type="button">Clear</button>
      <span id="b64-toast" class="copy-toast" hidden>✓ Copied!</span>
    </div>
  </section>

  <div class="page-footer-nav">
    <a href={`${baseUrl}tools`} class="back-link">&larr; Back to all tools</a>
  </div>
</Layout>

<script>
  function toBase64(text: string): string {
    const bytes = new TextEncoder().encode(text);
    let binary = '';
    bytes.forEach((b) => { binary += String.fromCharCode(b); });
    return btoa(binary);
  }

  function fromBase64(value: string): string {
    // Accept both the standard and the URL-safe alphabet, with or without padding.
    const normalized = value.trim().replace(/-/g, '+').replace(/_/g, '/').replace(/\s+/g, '');
    const padded = normalized + '='.repeat((4 - (normalized.length % 4)) % 4);
    const binary = atob(padded);
    const bytes = Uint8Array.from(binary, (c) => c.charCodeAt(0));
    return new TextDecoder('utf-8', { fatal: true }).decode(bytes);
  }

  function convert(mode: string, dir: string, input: string): string {
    if (dir === 'encode') {
      if (mode === 'url') return encodeURIComponent(input);
      const b64 = toBase64(input);
      return mode === 'base64url' ? b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '') : b64;
    }
    return mode === 'url' ? decodeURIComponent(input) : fromBase64(input);
  }

  function setupBase64() {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const mode = $<HTMLSelectElement>('b64-mode');
    const dir = $<HTMLSelectElement>('b64-dir');
    const input = $<HTMLTextAreaElement>('b64-input');
    const output = $<HTMLTextAreaElement>('b64-output');
    const error = $('b64-error');
    const toast = $('b64-toast');
    if (!mode || !dir || !input || !output || !error) return;

    function run() {
      error!.hidden = true;
      if (!input!.value) { output!.value = ''; return; }
      try {
        output!.value = convert(mode!.value, dir!.value, input!.value);
      } catch {
        output!.value = '';
        error!.textContent = dir!.value === 'decode'
          ? 'This input is not valid for the selected format.'
          : 'Could not encode this input.';
        error!.hidden = false;
      }
    }

    [mode, dir].forEach((el) => el.addEventListener('change', run));
    input.addEventListener('input', run);

    $('b64-copy-btn')?.addEventListener('click', async () => {
      if (!output!.value) return;
      try { await navigator.clipboard.writeText(output!.value); } catch { output!.select(); }
      if (toast) {
        toast.hidden = false;
        setTimeout(() => { toast.hidden = true; }, 2200);
      }
    });

    $('b64-swap-btn')?.addEventListener('click', () => {
      if (!output!.value) return;
      input!.value = output!.value;
      dir!.value = dir!.value === 'encode' ? 'decode' : 'encode';
      run();
    });

    $('b64-clear-btn')?.addEventListener('click', () => {
      input!.value = '';
      run();
    });

    run();
  }

  document.addEventListener('astro:page-load', setupBase64);
</script>
