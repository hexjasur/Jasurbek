---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title={`Özbek alifbosi konvertori | ${SITE_CONFIG.author}`} 
  description="Özbek matnini eski lotin (1995), yangi lotin (2026-yil 21-oktyabr) va kirill yozuvi orasida bepul, brauzerda ishlaydigan konvertor orqali almashtiring. Ma'lumotlaringiz serverga yuborilmaydi."
  activePage="tools"
  headerTitle={SITE_CONFIG.domain}
>
  <div class="back-link-wrap">
    <a href={`${baseUrl}tools`} class="back-link">&larr; Barcha vositalarga qaytish</a>
  </div>

  <div class="blog-intro">
    <div class="blog-meta-date">Birinchi nashr: 2026-10-21</div>
    <div class="blog-meta-date">Oxirgi yangilanish: 2026-11-11</div>
  </div>

  <section class="tools-box">
    <h2 class="page-title">
      <span class="alphabet-heading-mark" aria-hidden="true">ABC ⇄ АБВ</span>
      Özbek alifbosi konvertori (2026-yil 21-oktyabr islohoti)
    </h2>
    <p class="page-lead">
      Matnni eski lotin imlosi (1995), <strong>2026-yil 21-oktyabrda</strong> tasdiqlangan yangi lotin standarti (<strong>Ö, Ğ, Ç, Ş</strong> harflari bilan) va kirill yozuvi orasida erkin almashtiring.
    </p>

    <div class="tools-row">
      <label for="conversion-direction" class="field-label">
        Yönalish:
      </label>
      <select id="conversion-direction" class="tools-select">
        <option value="old-to-new">Eski lotin (1995) &rarr; Yangi lotin (2026-yil 21-oktyabr)</option>
        <option value="new-to-old">Yangi lotin (2026-yil 21-oktyabr) &rarr; Eski lotin (1995)</option>
        <option value="cyrillic-to-new">Kirill &rarr; Yangi lotin (2026-yil 21-oktyabr)</option>
        <option value="cyrillic-to-old">Kirill &rarr; Eski lotin (1995)</option>
        <option value="latin-to-cyrillic">Lotin (eski yoki yangi) &rarr; Kirill</option>
      </select>
    </div>

    <div class="converter-split">
      <div>
        <label for="input-text" class="field-label field-label-block">
          Kiritilgan matn:
        </label>
        <textarea id="input-text" placeholder="Matnni shu yerga yozing yoki qo'ying..." spellcheck="false"></textarea>
      </div>
      <div>
        <label for="output-text" class="field-label field-label-block">
          Natija:
        </label>
        <textarea id="output-text" readonly aria-label="Natija" placeholder="Natija shu yerda darhol chiqadi..."></textarea>
      </div>
    </div>

    <div class="tools-buttons">
      <button class="btn" id="convert-btn">Hozir ögirish</button>
      <button class="btn btn-secondary" id="copy-btn">Nusxa olish</button>
      <button class="btn btn-secondary" id="clear-btn">Tozalash</button>
      <span id="copy-toast" class="copy-toast" role="status" aria-live="polite" style="display: none;">
        ✓ Buferga nusxalandi!
      </span>
    </div>
  </section>

  <section class="section-gap">
    <h3 class="section-title">
      Rasmiy harflar moslik jadvali
    </h3>
    <div class="table-scroll">
      <table class="alphabet-table">
        <thead>
          <tr>
            <th>Kirill</th>
            <th>Eski lotin (1995)</th>
            <th>Yangi lotin (2026-yil 21-oktyabr)</th>
            <th>Izoh</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Ў ў</strong></td>
            <td>Oʻ oʻ (yoki O' o')</td>
            <td class="reformed-char">Ö ö</td>
            <td>Tutuqli unli harf o'rniga, ö tovushi uchun</td>
          </tr>
          <tr>
            <td><strong>Ғ ғ</strong></td>
            <td>Gʻ gʻ (yoki G' g')</td>
            <td class="reformed-char">Ğ ğ</td>
            <td>Tutuqli jarangli undosh o'rniga, ğ tovushi uchun</td>
          </tr>
          <tr>
            <td><strong>Ш ш</strong></td>
            <td>Sh sh</td>
            <td class="reformed-char">Ş ş</td>
            <td>Digraf sh o'rniga, bitta harf bilan</td>
          </tr>
          <tr>
            <td><strong>Ч ч</strong></td>
            <td>Ch ch</td>
            <td class="reformed-char">Ç ç</td>
            <td>Digraf ch o'rniga, bitta harf bilan</td>
          </tr>
          <tr>
            <td>Ж ж</td>
            <td>J j</td>
            <td>J j</td>
            <td>Özgarmagan</td>
          </tr>
          <tr>
            <td>Қ қ</td>
            <td>Q q</td>
            <td>Q q</td>
            <td>Özgarmagan</td>
          </tr>
          <tr>
            <td>Ҳ ҳ</td>
            <td>H h</td>
            <td>H h</td>
            <td>Özgarmagan</td>
          </tr>
          <tr>
            <td>Х х</td>
            <td>X x</td>
            <td>X x</td>
            <td>Özgarmagan</td>
          </tr>
          <tr>
            <td>Ъ ъ</td>
            <td>ʼ</td>
            <td>ʼ</td>
            <td>Tutuq belgisi (glottal undosh)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <div class="page-footer-nav">
    <a href={`${baseUrl}tools`} class="back-link">&larr; Barcha vositalarga qaytish</a>
  </div>
</Layout>

<script>
  function setupUzbekConverter() {
    const dirSelect = document.getElementById('conversion-direction') as HTMLSelectElement;
    const uzInput = document.getElementById('input-text') as HTMLTextAreaElement;
    const uzOutput = document.getElementById('output-text') as HTMLTextAreaElement;
    const uzConvertBtn = document.getElementById('convert-btn');
    const uzCopyBtn = document.getElementById('copy-btn');
    const uzClearBtn = document.getElementById('clear-btn');
    const copyToast = document.getElementById('copy-toast');

    if (!dirSelect || !uzInput || !uzOutput) return;

    const cyrillicToLatinMap: Record<string, string> = {
      'А': 'A', 'а': 'a', 'Б': 'B', 'б': 'b', 'В': 'V', 'в': 'v',
      'Г': 'G', 'г': 'g', 'Д': 'D', 'д': 'd', 'Е': 'E', 'е': 'e',
      'Ё': 'Yo', 'ё': 'yo', 'Ж': 'J', 'ж': 'j', 'З': 'Z', 'з': 'z',
      'И': 'I', 'и': 'i', 'Й': 'Y', 'й': 'y', 'К': 'K', 'к': 'k',
      'Л': 'L', 'М': 'M', 'м': 'm', 'Н': 'N', 'н': 'n',
      'О': 'O', 'о': 'o', 'П': 'P', 'п': 'p', 'Р': 'R', 'р': 'r',
      'С': 'S', 'с': 's', 'Т': 'T', 'т': 't', 'У': 'U', 'у': 'u',
      'Ф': 'F', 'Х': 'X', 'х': 'x', 'Ц': 'Ts', 'ц': 'ts',
      'Ч': 'Ç', 'ч': 'ç', 'Ш': 'Ş', 'ш': 'ş', 'Ъ': 'ʼ', 'ъ': 'ʼ',
      'Ь': '', 'ь': '', 'Э': 'E', 'э': 'e', 'Ю': 'Yu', 'ю': 'yu',
      'Я': 'Ya', 'я': 'ya', 'Ў': 'Ö', 'ў': 'ö', 'Қ': 'Q', 'қ': 'q',
      'Ғ': 'Ğ', 'ғ': 'ğ', 'Ҳ': 'H', 'ҳ': 'h',
    };

    const latinToCyrillicMap: Record<string, string> = {
      'A': 'А', 'a': 'а', 'B': 'Б', 'b': 'б', 'D': 'Д', 'd': 'д',
      'E': 'Е', 'e': 'е', 'F': 'Ф', 'f': 'ф', 'G': 'Г', 'g': 'г',
      'H': 'Ҳ', 'h': 'ҳ', 'I': 'И', 'i': 'и', 'J': 'Ж', 'j': 'ж',
      'K': 'К', 'k': 'к', 'L': 'Л', 'l': 'л', 'M': 'М', 'm': 'м',
      'N': 'Н', 'n': 'н', 'O': 'О', 'o': 'о', 'P': 'П', 'p': 'п',
      'Q': 'Қ', 'q': 'қ', 'R': 'Р', 'r': 'р', 'S': 'С', 's': 'с',
      'T': 'Т', 't': 'т', 'U': 'У', 'u': 'у', 'V': 'В', 'v': 'в',
      'X': 'Х', 'x': 'х', 'Y': 'Й', 'y': 'й', 'Z': 'З', 'z': 'з',
      'Ö': 'Ў', 'ö': 'ў', 'Ğ': 'Ғ', 'ğ': 'ғ', 'Ş': 'Ш', 'ş': 'ш',
      'Ç': 'Ч', 'ç': 'ч',
    };

    // Multi-character forms first: old digraphs and apostrophe letters.
    const latinDigraphs: [RegExp, string][] = [
      [/O[ʻ'’`‘]/g, 'Ў'], [/o[ʻ'’`‘]/g, 'ў'],
      [/G[ʻ'’`‘]/g, 'Ғ'], [/g[ʻ'’`‘]/g, 'ғ'],
      [/SH/g, 'Ш'], [/Sh/g, 'Ш'], [/sh/g, 'ш'],
      [/CH/g, 'Ч'], [/Ch/g, 'Ч'], [/ch/g, 'ч'],
      [/TS/g, 'Ц'], [/Ts/g, 'Ц'], [/ts/g, 'ц'],
      [/YO/g, 'Ё'], [/Yo/g, 'Ё'], [/yo/g, 'ё'],
      [/YU/g, 'Ю'], [/Yu/g, 'Ю'], [/yu/g, 'ю'],
      [/YA/g, 'Я'], [/Ya/g, 'Я'], [/ya/g, 'я'],
    ];

    function oldToNew(text: string): string {
      return text
        .replace(/O[ʻ'’`‘]/g, 'Ö')
        .replace(/o[ʻ'’`‘]/g, 'ö')
        .replace(/G[ʻ'’`‘]/g, 'Ğ')
        .replace(/g[ʻ'’`‘]/g, 'ğ')
        .replace(/SH/g, 'Ş')
        .replace(/Sh/g, 'Ş')
        .replace(/sh/g, 'ş')
        .replace(/CH/g, 'Ç')
        .replace(/Ch/g, 'Ç')
        .replace(/ch/g, 'ç');
    }

    function newToOld(text: string): string {
      return text
        .replace(/Ö/g, 'Oʻ')
        .replace(/ö/g, 'oʻ')
        .replace(/Ğ/g, 'Gʻ')
        .replace(/ğ/g, 'gʻ')
        .replace(/Ş/g, 'Sh')
        .replace(/ş/g, 'sh')
        .replace(/Ç/g, 'Ch')
        .replace(/ç/g, 'ch');
    }

    function cyrillicToNew(text: string): string {
      let res = '';
      for (const char of text) {
        res += cyrillicToLatinMap[char] !== undefined ? cyrillicToLatinMap[char] : char;
      }
      return res;
    }

    function latinToCyrillic(text: string): string {
      let res = text;
      for (const [re, cyr] of latinDigraphs) res = res.replace(re, cyr);
      let out = '';
      for (const char of res) {
        out += latinToCyrillicMap[char] !== undefined ? latinToCyrillicMap[char] : char;
      }
      return out;
    }

    function runConvert() {
      const dir = dirSelect.value;
      const text = uzInput.value;
      if (dir === 'old-to-new') uzOutput.value = oldToNew(text);
      else if (dir === 'new-to-old') uzOutput.value = newToOld(text);
      else if (dir === 'cyrillic-to-new') uzOutput.value = cyrillicToNew(text);
      else if (dir === 'cyrillic-to-old') uzOutput.value = newToOld(cyrillicToNew(text));
      else if (dir === 'latin-to-cyrillic') uzOutput.value = latinToCyrillic(text);
    }

    function showToast(message: string) {
      if (!copyToast) return;
      copyToast.textContent = message;
      copyToast.style.display = 'inline';
      setTimeout(() => { copyToast.style.display = 'none'; }, 2500);
    }

    uzInput.addEventListener('input', runConvert);
    dirSelect.addEventListener('change', runConvert);
    uzConvertBtn?.addEventListener('click', runConvert);

    uzCopyBtn?.addEventListener('click', async () => {
      if (!uzOutput.value) return;
      try {
        await navigator.clipboard.writeText(uzOutput.value);
        showToast('✓ Buferga nusxalandi!');
      } catch {
        uzOutput.select();
        showToast("Nusxalab bo'lmadi. Matn tanlandi, Ctrl+C bosing.");
      }
    });

    uzClearBtn?.addEventListener('click', () => {
      uzInput.value = '';
      uzOutput.value = '';
      uzInput.focus();
    });
  }

  document.addEventListener('astro:page-load', setupUzbekConverter);
</script>
