---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config';
import { BASE_URL as baseUrl } from '../../lib/url';
---

<Layout
  title={`WCAG Color Contrast Checker | ${SITE_CONFIG.author}`}
  description="Check the contrast ratio between two colors against WCAG 2.2 AA and AAA for normal text, large text and UI components. Runs in your browser."
  activePage="tools"
  headerTitle={SITE_CONFIG.domain}
>
  <div class="back-link-wrap">
    <a href={`${baseUrl}tools`} class="back-link">&larr; Back to all tools</a>
  </div>

  <section class="tools-box">
    <h2 class="page-title">🎨 WCAG Color Contrast Checker</h2>
    <p class="page-lead">
      Pick a text color and a background color to see the contrast ratio and whether it passes WCAG 2.2 AA and AAA.
      Good contrast keeps your UI readable for everyone, including people with low vision.
    </p>

    <div class="tools-row">
      <div class="color-field">
        <label for="cc-fg-text" class="field-label field-label-block">Text color</label>
        <div class="color-input-row">
          <input type="color" id="cc-fg-picker" value="#1f2328" aria-label="Pick text color" />
          <input type="text" id="cc-fg-text" class="tools-select" value="#1f2328" maxlength="7" spellcheck="false" />
        </div>
      </div>
      <div class="color-field">
        <label for="cc-bg-text" class="field-label field-label-block">Background color</label>
        <div class="color-input-row">
          <input type="color" id="cc-bg-picker" value="#fbf6ec" aria-label="Pick background color" />
          <input type="text" id="cc-bg-text" class="tools-select" value="#fbf6ec" maxlength="7" spellcheck="false" />
        </div>
      </div>
      <button class="btn btn-secondary btn-sm" id="cc-swap-btn" type="button">Swap colors</button>
    </div>

    <div id="cc-preview" class="contrast-preview" aria-live="polite">
      <p class="contrast-preview-large">Large text sample (24px)</p>
      <p>Normal text sample: the quick brown fox jumps over the lazy dog.</p>
    </div>

    <p class="contrast-ratio"><span id="cc-ratio">--</span><span class="contrast-ratio-suffix">: 1</span></p>
    <p id="cc-error" class="error-text" hidden>Enter a valid 6-digit hex color, for example #1f2328.</p>

    <div class="result-grid" id="cc-results">
      <div class="result-item"><span>Normal text, AA (4.5:1)</span><strong data-check="aa-normal">--</strong></div>
      <div class="result-item"><span>Normal text, AAA (7:1)</span><strong data-check="aaa-normal">--</strong></div>
      <div class="result-item"><span>Large text, AA (3:1)</span><strong data-check="aa-large">--</strong></div>
      <div class="result-item"><span>Large text, AAA (4.5:1)</span><strong data-check="aaa-large">--</strong></div>
      <div class="result-item"><span>UI components, AA (3:1)</span><strong data-check="aa-ui">--</strong></div>
    </div>
  </section>

  <div class="page-footer-nav">
    <a href={`${baseUrl}tools`} class="back-link">&larr; Back to all tools</a>
  </div>
</Layout>

<script>
  const HEX = /^#?([0-9a-f]{6})$/i;

  function parseHex(value: string): [number, number, number] | null {
    const m = HEX.exec(value.trim());
    if (!m) return null;
    const n = parseInt(m[1], 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }

  function luminance([r, g, b]: [number, number, number]): number {
    const lin = (c: number) => {
      const s = c / 255;
      return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
    };
    return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
  }

  function setupContrast() {
    const fgText = document.getElementById('cc-fg-text') as HTMLInputElement | null;
    const bgText = document.getElementById('cc-bg-text') as HTMLInputElement | null;
    const fgPicker = document.getElementById('cc-fg-picker') as HTMLInputElement | null;
    const bgPicker = document.getElementById('cc-bg-picker') as HTMLInputElement | null;
    const preview = document.getElementById('cc-preview');
    const ratioEl = document.getElementById('cc-ratio');
    const errorEl = document.getElementById('cc-error');
    const swap = document.getElementById('cc-swap-btn');
    if (!fgText || !bgText || !fgPicker || !bgPicker || !preview || !ratioEl || !errorEl) return;

    const checks: Record<string, number> = { 'aa-normal': 4.5, 'aaa-normal': 7, 'aa-large': 3, 'aaa-large': 4.5, 'aa-ui': 3 };

    function update() {
      const fg = parseHex(fgText!.value);
      const bg = parseHex(bgText!.value);
      errorEl!.hidden = !!(fg && bg);
      if (!fg || !bg) return;

      const l1 = luminance(fg);
      const l2 = luminance(bg);
      const ratio = (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
      ratioEl!.textContent = (Math.floor(ratio * 100) / 100).toFixed(2);

      preview!.style.color = fgText!.value;
      preview!.style.backgroundColor = bgText!.value;

      document.querySelectorAll<HTMLElement>('[data-check]').forEach((el) => {
        const pass = ratio >= checks[el.dataset.check ?? ''];
        el.textContent = pass ? 'Pass' : 'Fail';
        el.className = pass ? 'badge-pass' : 'badge-fail';
      });
    }

    const link = (picker: HTMLInputElement, text: HTMLInputElement) => {
      picker.addEventListener('input', () => { text.value = picker.value; update(); });
      text.addEventListener('input', () => {
        const rgb = parseHex(text.value);
        if (rgb) picker.value = `#${HEX.exec(text.value.trim())![1].toLowerCase()}`;
        update();
      });
    };
    link(fgPicker, fgText);
    link(bgPicker, bgText);

    swap?.addEventListener('click', () => {
      [fgText.value, bgText.value] = [bgText.value, fgText.value];
      [fgPicker.value, bgPicker.value] = [bgPicker.value, fgPicker.value];
      update();
    });

    update();
  }

  document.addEventListener('astro:page-load', setupContrast);
</script>
