---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

const toolsList = [
  {
    id: 'minifier',
    num: 4,
    title: 'Code & Data Minifier / Beautifier',
    description: 'Compress or beautify JSON payloads, CSS stylesheets, and JavaScript code with live payload size savings metrics.',
    slug: 'minifier'
  },
  {
    id: 'uuid-generator',
    num: 3,
    title: 'Cryptographic UUID & NanoID Generator',
    description: 'Generate cryptographically secure version 4 UUIDs (standard, uppercase, no hyphens) and URL-safe NanoIDs using native WebCrypto.',
    slug: 'uuid-generator'
  },
  {
    id: 'json-to-typescript',
    num: 2,
    title: 'JSON to TypeScript Interface Generator',
    description: 'Paste raw JSON data to instantly produce strongly-typed TypeScript interfaces with automatic nested type resolution.',
    slug: 'json-to-typescript'
  },
  {
    id: 'uzbek-alphabet',
    num: 1,
    title: 'Uzbek Alphabet Converter (October 21, 2026 Reform)',
    description: 'Convert text between 1995 legacy Latin, the official reformed Latin standard (Ö, Ğ, Ç, Ş), and Uzbek Cyrillic script.',
    slug: 'uzbek-alphabet'
  }
];
---

<Layout 
  title={`Tools & Utilities | ${SITE_CONFIG.author}`} 
  activePage="tools"
  headerTitle={SITE_CONFIG.domain}
>
  <div class="blog-intro">
    <h2 style="margin: 0 0 0.5rem; font-size: 1.35rem; font-weight: 700; color: #1f2328;">
      Tools & Utilities | {SITE_CONFIG.domain}
    </h2>
    <div class="blog-meta-date">Category: In-Browser Developer Utilities</div>
    <div class="blog-meta-date">Last Updated: 2026-11-01</div>

    <p class="blog-desc">
      A collection of client-side developer utilities designed for speed, privacy, and zero latency. All operations are processed entirely inside your browser — no inputs, tokens, or code snippets are ever transmitted to any server.
    </p>
  </div>

  <h3 class="blog-entries-title" style="margin-top: 2rem;">Available Developer Tools</h3>

  <div class="blog-grid">
    {toolsList.map((tool) => (
      <article class="blog-card">
        <div class="blog-card-header">
          <span class="blog-card-num">{tool.num}.</span>
          <a href={`${baseUrl}tools/${tool.slug}`}>{tool.title}</a>
        </div>
        <p style="font-size: 0.93rem; color: #57606a; margin: 0.65rem 0 0; line-height: 1.55;">
          {tool.description}
        </p>
      </article>
    ))}
  </div>
</Layout>
