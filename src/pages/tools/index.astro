---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config';
import { toolsList } from '../../data/tools';
import { BASE_URL as baseUrl } from '../../lib/url';
---

<Layout 
  title={`Tools & Utilities | ${SITE_CONFIG.author}`} 
  description="Free browser-based developer utilities for UUID generation, JSON to TypeScript conversion, code minification, and Uzbek alphabet conversion."
  activePage="tools"
  headerTitle={SITE_CONFIG.domain}
>
  <div class="blog-intro">
    <h2 style="margin: 0 0 0.5rem; font-size: 1.35rem; font-weight: 700; color: #1f2328;">
      Tools & Utilities | {SITE_CONFIG.domain}
    </h2>
    <div class="blog-meta-date">Category: In-Browser Developer Utilities</div>
    <div class="blog-meta-date">Last Updated: 2026-11-01</div>

    <p class="blog-desc">
      A collection of client-side developer utilities designed for speed, privacy, and zero latency. All operations are processed entirely inside your browser — no inputs, tokens, or code snippets are ever transmitted to any server.
    </p>
  </div>

  <h3 class="blog-entries-title" style="margin-top: 2rem;">Available Developer Tools</h3>

  <div class="blog-grid">
    {toolsList.map((tool) => (
      <article class="blog-card">
        <div class="blog-card-header">
          <span class="blog-card-num">{tool.num}.</span>
          <a href={`${baseUrl}tools/${tool.slug}`}>{tool.title}</a>
        </div>
        <p style="font-size: 0.93rem; color: #57606a; margin: 0.65rem 0 0; line-height: 1.55;">
          {tool.description}
        </p>
      </article>
    ))}
  </div>
</Layout>
