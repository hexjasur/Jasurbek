---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config';
import { toolsList } from '../../data/tools';
import { BASE_URL as baseUrl } from '../../lib/url';
---

<Layout 
  title={`Tools & Utilities | ${SITE_CONFIG.author}`} 
  description="Free browser-based developer & student utilities: HEMIS kredit-modul hisoblagich, color contrast checker, CSS clamp() generator, Base64 and URL encoder, UUID generator, JSON to TypeScript, minifier and Uzbek alphabet converter."
  activePage="tools"
  headerTitle={SITE_CONFIG.domain}
>
  <div class="blog-intro">
    <h2 class="page-title">
      Tools & Utilities | {SITE_CONFIG.domain}
    </h2>
    <div class="blog-meta-date">First Published: 2026-11-01</div>
    <div class="blog-meta-date">Last Updated: 2026-11-14</div>

    <p class="blog-desc">
      A collection of client-side utilities designed for speed, privacy, and zero latency. Most operations are processed entirely inside your browser — no inputs, tokens, or personal calculations are ever transmitted to any server. A small number of tools connect to external APIs to deliver their functionality; those cases are clearly noted on each tool's page.
    </p>
    <p class="tools-disclaimer-note">
      <strong>Disclaimer:</strong> These tools are provided "as is" without warranties. Use at your own risk and always verify results independently. By using these tools you accept the{' '}
      <a href="/entry/privacy_policy#web-tools-disclaimer">Web Tools Disclaimer</a>.
    </p>
  </div>

  <h3 class="blog-entries-title section-gap">All Tools</h3>

  <div class="blog-grid">
    {toolsList.map((tool) => (
      <article class="blog-card">
        <div class="blog-card-header">
          <span class="blog-card-num">{tool.num}.</span>
          <a href={`${baseUrl}tools/${tool.slug}`}>{tool.title}</a>
        </div>
        <p class="card-desc">
          {tool.description}
        </p>
      </article>
    ))}
  </div>
</Layout>

<style>
  .tools-disclaimer-note {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-soft);
    line-height: 1.6;
  }

  .tools-disclaimer-note a {
    color: var(--flora-orange, #b86752);
    text-decoration: underline;
  }
</style>
