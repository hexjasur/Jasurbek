---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config';
import { BASE_URL as baseUrl } from '../../lib/url';

const seoTitle = 'Kredit Modul Hisoblagich (HEMIS) — 1 Kredit Narxi va Akademik Qarzdorlik';
const seoDescription = "OTM talabalari uchun HEMIS kredit-modul tizimida 1 kredit narxi, akademik qarzdorlik (qayta o'qish / peresdacha) va fanlar farqi (perevod) to'lovini yillik kontrakt asosida aniq va qulay hisoblash kalkulyatori.";
const seoTags = [
  'kredit modul hisoblash',
  'hemis kredit hisoblash',
  '1 kredit narxi',
  'kredit narxini hisoblash',
  'kredit qiymati',
  'akademik qarzdorlik hisoblash',
  'qayta oqish tolovi',
  'fanlar farqi tolovi',
  'peresdacha tolovi',
  'ects kalkulyator',
  'otm kontrakt narxi',
  'oliygoh kredit hisobi',
  'hemis tizimi',
  'talabalar uchun kredit hisoblagich',
];
---

<Layout
  title={`${seoTitle} | ${SITE_CONFIG.author}`}
  description={seoDescription}
  activePage="tools"
  headerTitle={SITE_CONFIG.domain}
  tags={seoTags}
>
  <div class="back-link-wrap">
    <a href={`${baseUrl}tools`} class="back-link">&larr; Barcha vositalarga qaytish</a>
  </div>

  <section class="tools-box credit-calculator-section">
    <div class="calc-header">
      <div class="calc-badge">HEMIS / ECTS Standarti</div>
      <h1 class="page-title calc-title">
        <svg class="title-svg" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="2" width="16" height="20" rx="2" />
          <line x1="8" y1="6" x2="16" y2="6" />
          <line x1="16" y1="14" x2="16" y2="18" />
          <path d="M16 10h.01M12 10h.01M8 10h.01M12 14h.01M8 14h.01M12 18h.01M8 18h.01" />
        </svg>
        Kredit-Modul va Qayta Oʻqish Hisoblagichi
      </h1>
      <p class="page-lead">
        Oliy taʼlim muassasalarida (OTM) akademik qarzdorlikni yopish (qayta oʻqish) yoki fanlar farqi uchun <strong>1 ta kredit qiymati</strong> hamda <strong>jami toʻlov summasini</strong> hisoblang.
      </p>
    </div>

    <!-- Rasmiy formula infografikasi: Telefonda qatorlarga parchalanmaydi, yaxlit matematik formula holida turadi -->
    <div class="formula-banner">
      <div class="formula-banner-top">
        <span class="formula-tag">Rasmiy hisoblash formulasi</span>
        <span class="formula-source">Oʻzbekiston Respublikasi OTMlari</span>
      </div>

      <div class="formula-scroll-wrap" tabindex="0" role="region" aria-label="Kredit hisoblash formulasi">
        <div class="formula-visual">
          <div class="formula-side-lhs">1 kredit narxi</div>
          <div class="formula-operator">=</div>
          <div class="formula-fraction">
            <div class="fraction-num">Yoʻnalishning 1 yillik kontrakt narxi (stipendiyasiz)</div>
            <div class="fraction-line"></div>
            <div class="fraction-den">1 yildagi umumiy kredit miqdori (odatda 60 kredit)</div>
          </div>
        </div>
      </div>

      <div class="formula-example">
        <span class="formula-example-label">Amaliy misol:</span>
        Agar yoʻnalish yillik kontrakti <code>8 510 000 soʻm</code> boʻlsa:
        <span class="formula-example-math">8 510 000 &divide; 60 = <strong>141 833 soʻm</strong></span>
      </div>
    </div>

    <!-- Asosiy parametrlar formasi -->
    <div class="calc-grid">
      <!-- 1-qadam: Kontrakt miqdori -->
      <div class="input-card">
        <div class="step-badge">1-qadam</div>
        <label for="contract-input" class="field-label-prominent">
          Yillik kontrakt narxi (stipendiyasiz, soʻmda):
        </label>
        <div class="input-with-addon">
          <input
            id="contract-input"
            type="text"
            inputmode="numeric"
            class="tools-select calc-input-lg"
            value="8 510 000"
            placeholder="8 510 000"
            aria-label="Yillik kontrakt miqdori"
          />
          <span class="input-addon">soʻm</span>
        </div>

        <div class="preset-label">OTM yoʻnalishlari boʻyicha andazalar:</div>
        <div class="preset-pills" id="contract-presets">
          <button type="button" class="preset-pill" data-amount="7400000" title="Pedagogika, gumanitar yoʻnalishlar">
            <span class="preset-sum">7 400 000</span>
            <small>Pedagogika</small>
          </button>
          <button type="button" class="preset-pill active" data-amount="8510000" title="Tabiiy fanlar, gumanitar bazaviy">
            <span class="preset-sum">8 510 000</span>
            <small>Gumanitar (standart)</small>
          </button>
          <button type="button" class="preset-pill" data-amount="9600000" title="Muhandislik, IT, axborot xavfsizligi">
            <span class="preset-sum">9 600 000</span>
            <small>IT va Texnika</small>
          </button>
          <button type="button" class="preset-pill" data-amount="11000000" title="Iqtisodiyot, bank ishi, moliya">
            <span class="preset-sum">11 000 000</span>
            <small>Iqtisodiyot</small>
          </button>
          <button type="button" class="preset-pill" data-amount="13500000" title="Yurisprudensiya, xalqaro munosabatlar">
            <span class="preset-sum">13 500 000</span>
            <small>Huquq</small>
          </button>
          <button type="button" class="preset-pill" data-amount="16000000" title="Tibbiyot, davolash ishi, stomatologiya">
            <span class="preset-sum">16 000 000</span>
            <small>Tibbiyot</small>
          </button>
        </div>
      </div>

      <!-- 2-qadam: 1 yillik kredit hajmi -->
      <div class="input-card">
        <div class="step-badge">2-qadam</div>
        <label class="field-label-prominent">
          1 oʻquv yilidagi kreditlar soni:
        </label>
        <div class="credits-base-selector">
          <label class="radio-chip">
            <input type="radio" name="credit-base" value="60" checked />
            <span class="chip-content">
              <strong>60 kredit</strong>
              <small>Standart 1 oʻquv yili (2 semestr)</small>
            </span>
          </label>
          <label class="radio-chip">
            <input type="radio" name="credit-base" value="30" />
            <span class="chip-content">
              <strong>30 kredit</strong>
              <small>1 semestr hajmi</small>
            </span>
          </label>
          <label class="radio-chip">
            <input type="radio" name="credit-base" value="custom" />
            <span class="chip-content">
              <strong>Boshqa</strong>
              <small>Ixtiyoriy kredit soni</small>
            </span>
          </label>
        </div>
        <div id="custom-base-wrap" class="custom-base-wrap" style="display: none;">
          <label for="custom-base-input" class="field-label field-label-inline">Kredit soni:</label>
          <input
            id="custom-base-input"
            type="number"
            min="1"
            max="120"
            value="60"
            class="tools-select custom-base-field"
          />
        </div>
      </div>
    </div>

    <!-- 3-qadam: Hisoblash rejimi (Tabs) -->
    <div class="calc-mode-card">
      <div class="step-badge">3-qadam</div>
      <div class="mode-tabs-header">
        <label class="field-label-prominent" style="margin-bottom: 0;">
          Hisoblash usuli:
        </label>
        <div class="mode-tab-buttons" role="tablist">
          <button type="button" class="mode-tab active" id="tab-quick" role="tab" aria-selected="true">
            <svg class="tab-svg" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
            </svg>
            Tezkor rejim
          </button>
          <button type="button" class="mode-tab" id="tab-subjects" role="tab" aria-selected="false">
            <svg class="tab-svg" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            </svg>
            Fanlar roʻyxati
          </button>
        </div>
      </div>

      <!-- 1-rejim: Tezkor kredit kiritish -->
      <div id="mode-quick-panel" class="mode-panel active">
        <div class="quick-input-row">
          <div class="quick-input-wrap">
            <label for="quick-credits-input" class="field-label field-label-block">
              Qarzdorlik / farq kreditlari soni:
            </label>
            <div class="stepper-wrap">
              <button type="button" class="btn-stepper" id="btn-credit-dec" aria-label="Kreditni kamaytirish">−</button>
              <input
                id="quick-credits-input"
                type="number"
                min="0.5"
                max="120"
                step="0.5"
                value="6"
                class="tools-select stepper-input"
              />
              <button type="button" class="btn-stepper" id="btn-credit-inc" aria-label="Kreditni oshirish">+</button>
              <span class="stepper-unit">kredit</span>
            </div>
          </div>

          <div class="quick-chips-wrap">
            <span class="quick-chips-label">Tezkor tanlov:</span>
            <div class="credit-preset-pills">
              <button type="button" class="credit-pill" data-credit="2" title="2 kredit">+2 kr</button>
              <button type="button" class="credit-pill" data-credit="3" title="3 kredit">+3 kr</button>
              <button type="button" class="credit-pill" data-credit="4" title="4 kredit">+4 kr</button>
              <button type="button" class="credit-pill" data-credit="5" title="5 kredit">+5 kr</button>
              <button type="button" class="credit-pill active" data-credit="6" title="6 kredit">6 kr</button>
              <button type="button" class="credit-pill" data-credit="8" title="8 kredit">+8 kr</button>
              <button type="button" class="credit-pill" data-credit="12" title="12 kredit">12 kr</button>
              <button type="button" class="credit-pill" data-credit="30" title="30 kredit (1 semestr)">30 kr</button>
            </div>
          </div>
        </div>
      </div>

      <!-- 2-rejim: Fanlar ro'yxati -->
      <div id="mode-subjects-panel" class="mode-panel" style="display: none;">
        <p class="mode-description">
          Har bir fanni nomi va krediti bilan kiriting. Har bir fanning alohida toʻlovi va umumiy summa avtomatik hisoblanadi.
        </p>

        <div class="subjects-table-wrap">
          <table class="subjects-table" id="subjects-table">
            <thead>
              <tr>
                <th style="width: 44%;">Fan nomi</th>
                <th style="width: 20%;">Krediti</th>
                <th style="width: 26%;">Toʻlov</th>
                <th style="width: 10%; text-align: center;">Oʻchirish</th>
              </tr>
            </thead>
            <tbody id="subjects-list">
              <!-- Dynamically populated via JS -->
            </tbody>
          </table>
        </div>

        <div class="subjects-actions">
          <button type="button" class="btn btn-secondary btn-sm" id="btn-add-subject">
            + Yangi fan qoʻshish
          </button>
          <button type="button" class="btn-link-subtle" id="btn-reset-subjects">
            Tozalash
          </button>
        </div>
      </div>
    </div>

    <!-- NATIJALAR PANELI -->
    <div class="results-container">
      <!-- Bosh natija kartasi (Hero) -->
      <div class="result-hero-card">
        <div class="hero-top-label">Jami toʻlanishi kerak boʻlgan summa:</div>
        <div class="hero-amount-wrap">
          <span class="hero-amount" id="result-total-amount">851 000</span>
          <span class="hero-currency">soʻm</span>
        </div>
        <div class="hero-in-words-box">
          <span class="in-words-label">Soʻz bilan:</span>
          <span class="in-words-value" id="result-in-words">Sakkiz yuz ellik bir ming soʻm</span>
        </div>
      </div>

      <!-- 4 ta asosiy metrika -->
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-icon-box">
            <svg class="metric-svg" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23" />
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
          </div>
          <div class="metric-body">
            <div class="metric-label">1 kredit qiymati</div>
            <div class="metric-value" id="result-per-credit">141 833 soʻm</div>
            <div class="metric-sub" id="result-per-credit-raw">Aniq: 141 833.33 soʻm</div>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-box">
            <svg class="metric-svg" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2" />
              <polyline points="2 17 12 22 22 17" />
              <polyline points="2 12 12 17 22 12" />
            </svg>
          </div>
          <div class="metric-body">
            <div class="metric-label">Qarzdorlik hajmi</div>
            <div class="metric-value" id="result-total-credits">6 kredit</div>
            <div class="metric-sub" id="result-subjects-count">1 ta yoʻnalish boʻyicha</div>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-box">
            <svg class="metric-svg" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
          </div>
          <div class="metric-body">
            <div class="metric-label">Oʻquv yuklamasi</div>
            <div class="metric-value" id="result-total-hours">180 soat</div>
            <div class="metric-sub">1 kredit = 30 soat</div>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-box">
            <svg class="metric-svg" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="5" x2="5" y2="19" />
              <circle cx="6.5" cy="6.5" r="2.5" />
              <circle cx="17.5" cy="17.5" r="2.5" />
            </svg>
          </div>
          <div class="metric-body">
            <div class="metric-label">Kontraktga nisbati</div>
            <div class="metric-value" id="result-percent">10.0%</div>
            <div class="metric-sub">Yillik toʻlov ulushi</div>
          </div>
        </div>
      </div>

      <!-- Formulaning amaldagi hisobi -->
      <div class="calculation-breakdown">
        <div class="breakdown-title">
          <span>Hisoblash bosqichlari:</span>
        </div>
        <div class="breakdown-steps">
          <div class="breakdown-step" id="breakdown-step-1">
            <code>1 kredit narxi = 8 510 000 &divide; 60 = 141 833.33 soʻm</code>
          </div>
          <div class="breakdown-step" id="breakdown-step-2">
            <code>Jami toʻlov = 141 833.33 &times; 6 = <strong>851 000 soʻm</strong></code>
          </div>
        </div>
      </div>

      <!-- Amallar paneli -->
      <div class="tools-buttons calc-action-bar">
        <button type="button" class="btn" id="btn-copy-summary">
          <svg class="btn-svg" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          Natijani nusxalash (Telegram / Xabar)
        </button>
        <button type="button" class="btn btn-secondary" id="btn-reset-all">
          <svg class="btn-svg" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10" />
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
          </svg>
          Boshlangʻich holatga qaytarish
        </button>
        <span id="calc-toast" class="copy-toast" style="display: none;">
          ✓ Toʻlov hisoboti nusxalandi!
        </span>
      </div>
    </div>
  </section>

  <!-- Savol-Javoblar va Nizom Qo'llanmasi -->
  <section class="section-gap info-section">
    <h2 class="section-title">
      OTM Kredit-Modul Tizimi Boʻyicha Eslatma va Yoʻriqnoma
    </h2>

    <div class="faq-cards-grid">
      <div class="faq-card">
        <h3 class="faq-title">1. Kredit narxi qanday mezon asosida hisoblanadi?</h3>
        <p class="faq-text">
          Oʻzbekiston Respublikasi Vazirlar Mahkamasining <strong>824-son qarori</strong>ga muvofiq, 1 ta kredit qiymati talaba taʼlim olayotgan muayyan yoʻnalish boʻyicha belgilangan <strong>yillik bazaviy (stipendiyasiz) kontrakt narxini</strong> oʻquv yilidagi jami kreditlar miqdoriga (odatda <strong>60 kredit</strong>ga) boʻlish orqali chiqariladi.
        </p>
      </div>

      <div class="faq-card">
        <h3 class="faq-title">2. Stipendiyali kontrakt bilan stipendiyasiz kontrakt farqi bormi?</h3>
        <p class="faq-text">
          <strong>Yoʻq, farq qilmaydi.</strong> Kredit qiymatini hisoblashda talaba stipendiyali yoki stipendiyasiz toʻlovda oʻqishidan qatʼi nazar, doimo <em>stipendiyasiz bazaviy kontrakt summasi</em> olinadi. OTM tomonidan talabaga ortiqcha toʻlov yuklanishi qonunga ziddir.
        </p>
      </div>

      <div class="faq-card">
        <h3 class="faq-title">3. Akademik qarzdorlikni (qayta oʻqishni) qachon va qanday yopiladi?</h3>
        <p class="faq-text">
          Oraliq yoki yakuniy nazoratlardan oʻta olmagan (qoniqarsiz baholangan) talaba mazkur fandan kredit toʻlovini toʻlaydi va semestrlar oraligʻida yoki yozgi taʼtilda fanni qayta oʻqib, qayta topshiradi. Kredit toʻlovi toʻlangach, talabaga dars jadvali va qayta topshirish ruxsatnomasi shakllantiriladi.
        </p>
      </div>

      <div class="faq-card">
        <h3 class="faq-title">4. Fanlar farqi (oʻqishni koʻchirish / perevod) qanday toʻlanadi?</h3>
        <p class="faq-text">
          Boshqa OTMdan yoki boshqa taʼlim yoʻnalishidan oʻqishni koʻchirganda (yoki qayta tiklaganda), oʻquv rejasida mavjud boʻlmagan yoki soatlari toʻgʻri kelmagan fanlar farqi hisoblanadi. Talaba faqatgina farq qilgan fanlar kreditlari miqdori uchun toʻlov qiladi.
        </p>
      </div>

      <div class="faq-card">
        <h3 class="faq-title">5. 1 ta kredit necha akademik soatga teng?</h3>
        <p class="faq-text">
          Oʻzbekiston ECTS kredit-modul tizimida <strong>1 kredit = 30 akademik soat</strong> deb belgilangan. Bu soat auditoriya mashgʻulotlari (maʼruza, amaliy, laboratoriya) hamda talabaning mustaqil taʼlim soatlarini oʻz ichiga oladi. 1 yillik 60 kredit esa <strong>1800 soatlik</strong> oʻquv yuklamasini tashkil etadi.
        </p>
      </div>

      <div class="faq-card">
        <h3 class="faq-title">6. Toʻlovni amalga oshirishda nimalarga eʼtibor berish kerak?</h3>
        <p class="faq-text">
          Bank kvitansiyasida yoki toʻlov ilovalari (Payme, Click, Uzum) orqali toʻlayotganda toʻlov maqsadida albatta: <em>«F.I.SH., HEMIS ID raqami, Qayta oʻqish / fanlar farqi toʻlovi»</em> deb aniq koʻrsatish tavsiya etiladi.
        </p>
      </div>
    </div>
  </section>

  <div class="page-footer-nav">
    <a href={`${baseUrl}tools`} class="back-link">&larr; Barcha vositalarga qaytish</a>
  </div>
</Layout>

<style>
  .credit-calculator-section {
    padding: 1.8rem;
  }

  .calc-header {
    margin-bottom: 1.4rem;
  }

  .calc-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background: var(--reformed-bg, rgba(199, 210, 177, 0.42));
    color: var(--text-copy, #3f5147);
    border: 1px solid var(--sep-color, #8f9b8c);
    margin-bottom: 0.5rem;
  }

  .calc-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.5rem;
  }

  .title-svg {
    width: 28px;
    height: 28px;
    color: var(--focus, #0969da);
    flex-shrink: 0;
  }

  .tab-svg {
    width: 15px;
    height: 15px;
    margin-right: 0.35rem;
    display: inline-block;
    vertical-align: -2px;
    flex-shrink: 0;
  }

  .btn-svg {
    width: 16px;
    height: 16px;
    margin-right: 0.4rem;
    display: inline-block;
    vertical-align: -2px;
    flex-shrink: 0;
  }

  /* Formula Banner */
  .formula-banner {
    background: var(--surface-2, #f6f8fa);
    border: 1.5px dashed var(--line-soft, #d0d7de);
    border-radius: 8px;
    padding: 1.1rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  .formula-banner-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
  }

  .formula-tag {
    font-weight: 600;
    color: var(--focus, #0969da);
    background: var(--accent-soft, #eef3ff);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    border: 1px solid var(--accent-line, #cfe0fc);
  }

  .formula-source {
    color: var(--text-faint, #6e7781);
    font-size: 0.82rem;
  }

  /* Formula gorizontal yaxlit turishi uchun maxsus o'ram */
  .formula-scroll-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0.35rem 0.25rem 0.65rem;
  }

  .formula-visual {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-strong, #1f2328);
    min-width: 100%;
    white-space: nowrap;
  }

  .formula-side-lhs {
    background: var(--surface, #ffffff);
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--border-color, #d0d7de);
    border-radius: 6px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .formula-operator {
    font-size: 1.35rem;
    color: var(--text-soft, #57606a);
    flex-shrink: 0;
  }

  .formula-fraction {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex-shrink: 0;
  }

  .fraction-num {
    padding-bottom: 0.25rem;
    color: var(--focus, #0969da);
    font-weight: 700;
    white-space: nowrap;
  }

  .fraction-line {
    width: 100%;
    height: 2px;
    background: var(--text-strong, #1f2328);
    margin: 0.05rem 0;
  }

  .fraction-den {
    padding-top: 0.25rem;
    color: var(--text-body, #24292f);
    font-size: 0.92rem;
    white-space: nowrap;
  }

  .formula-example {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line-soft, #d0d7de);
    font-size: 0.88rem;
    color: var(--text-muted, #57606a);
    line-height: 1.5;
  }

  .formula-example-label {
    font-weight: 700;
    color: var(--text-strong, #1f2328);
    margin-right: 0.25rem;
  }

  .formula-example-math {
    display: inline-block;
    margin-left: 0.35rem;
    background: var(--surface, #ffffff);
    border: 1px solid var(--line-soft, #d0d7de);
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    color: var(--focus-strong, #0856b3);
  }

  .formula-example code {
    background: var(--surface, #ffffff);
    border: 1px solid var(--line-soft, #d0d7de);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-weight: 600;
  }

  /* Grid for inputs */
  .calc-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .input-card {
    background: var(--surface, #ffffff);
    border: 1.5px solid var(--border-color, #d0d7de);
    border-radius: 8px;
    padding: 1.25rem;
    position: relative;
  }

  .step-badge {
    position: absolute;
    top: -10px;
    left: 14px;
    background: var(--btn-bg, #b86752);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .field-label-prominent {
    display: block;
    font-size: 0.94rem;
    font-weight: 700;
    color: var(--text-strong, #1f2328);
    margin-bottom: 0.65rem;
  }

  .input-with-addon {
    display: flex;
    align-items: center;
    position: relative;
  }

  .calc-input-lg {
    width: 100%;
    font-size: 1.25rem;
    font-weight: 700;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    padding: 0.6rem 4.5rem 0.6rem 0.85rem;
    border-radius: 6px;
    border: 2px solid var(--line-soft, #d0d7de);
    background: var(--surface, #ffffff);
    color: var(--text-strong, #1f2328);
    height: 48px;
  }

  .calc-input-lg:focus {
    outline: none;
    border-color: var(--focus, #0969da);
    box-shadow: 0 0 0 3px rgba(9, 105, 218, 0.15);
  }

  .input-addon {
    position: absolute;
    right: 12px;
    font-weight: 700;
    color: var(--text-faint, #6e7781);
    pointer-events: none;
  }

  .preset-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-faint, #6e7781);
    margin-top: 0.85rem;
    margin-bottom: 0.45rem;
  }

  .preset-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .preset-pill {
    background: var(--surface-2, #f6f8fa);
    border: 1px solid var(--line-soft, #d0d7de);
    border-radius: 6px;
    padding: 0.35rem 0.6rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-body, #24292f);
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.2;
    text-align: left;
  }

  .preset-sum {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-weight: 700;
  }

  .preset-pill small {
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--text-faint, #6e7781);
    margin-top: 0.1rem;
  }

  .preset-pill:hover {
    border-color: var(--focus, #0969da);
    background: var(--accent-soft, #eef3ff);
  }

  .preset-pill.active {
    background: var(--accent-soft, #eef3ff);
    border-color: var(--focus, #0969da);
    color: var(--focus-strong, #0856b3);
    box-shadow: 0 0 0 1px var(--focus, #0969da);
  }

  /* Credits base radio chips */
  .credits-base-selector {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .radio-chip {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border: 1.5px solid var(--line-soft, #d0d7de);
    border-radius: 6px;
    padding: 0.55rem 0.85rem;
    cursor: pointer;
    background: var(--surface-2, #f6f8fa);
    transition: all 0.15s ease;
  }

  .radio-chip:hover {
    border-color: var(--focus, #0969da);
  }

  .radio-chip:has(input:checked) {
    border-color: var(--focus, #0969da);
    background: var(--accent-soft, #eef3ff);
  }

  .chip-content {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .chip-content strong {
    font-size: 0.92rem;
    color: var(--text-strong, #1f2328);
  }

  .chip-content small {
    font-size: 0.75rem;
    color: var(--text-faint, #6e7781);
  }

  .custom-base-wrap {
    margin-top: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .custom-base-field {
    width: 90px;
    font-weight: 700;
    text-align: center;
  }

  /* Mode selection card */
  .calc-mode-card {
    background: var(--surface, #ffffff);
    border: 1.5px solid var(--border-color, #d0d7de);
    border-radius: 8px;
    padding: 1.25rem;
    position: relative;
    margin-bottom: 1.75rem;
  }

  .mode-tabs-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line-soft, #d0d7de);
  }

  .mode-tab-buttons {
    display: flex;
    gap: 0.4rem;
  }

  .mode-tab {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    font-size: 0.86rem;
    font-weight: 600;
    border: 1px solid var(--line-soft, #d0d7de);
    background: var(--surface-2, #f6f8fa);
    border-radius: 6px;
    color: var(--text-body, #24292f);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mode-tab:hover {
    border-color: var(--focus, #0969da);
  }

  .mode-tab.active {
    background: var(--focus, #0969da);
    color: #ffffff;
    border-color: var(--focus, #0969da);
  }

  /* Mode Quick */
  .quick-input-row {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .quick-input-wrap {
    flex: 1 1 260px;
  }

  .stepper-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .btn-stepper {
    width: 44px;
    height: 44px;
    font-size: 1.4rem;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--line-soft, #d0d7de);
    border-radius: 6px;
    background: var(--surface-2, #f6f8fa);
    color: var(--text-strong, #1f2328);
    cursor: pointer;
    transition: background 0.15s;
    flex-shrink: 0;
  }

  .btn-stepper:hover {
    background: var(--line-soft, #d0d7de);
  }

  .stepper-input {
    width: 90px;
    height: 44px;
    font-size: 1.3rem;
    font-weight: 700;
    text-align: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    border: 2px solid var(--line-soft, #d0d7de);
    border-radius: 6px;
  }

  .stepper-unit {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-muted, #57606a);
    margin-left: 0.25rem;
  }

  .quick-chips-wrap {
    flex: 2 1 280px;
  }

  .quick-chips-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-faint, #6e7781);
    margin-bottom: 0.4rem;
  }

  .credit-preset-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .credit-pill {
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    background: var(--surface-2, #f6f8fa);
    border: 1px solid var(--line-soft, #d0d7de);
    border-radius: 6px;
    color: var(--text-body, #24292f);
    cursor: pointer;
    transition: all 0.15s;
  }

  .credit-pill:hover {
    border-color: var(--focus, #0969da);
    background: var(--accent-soft, #eef3ff);
  }

  .credit-pill.active {
    background: var(--accent-soft, #eef3ff);
    border-color: var(--focus, #0969da);
    color: var(--focus-strong, #0856b3);
    font-weight: 700;
  }

  /* Mode Subjects */
  .mode-description {
    font-size: 0.9rem;
    color: var(--text-muted, #57606a);
    margin-bottom: 0.85rem;
  }

  .subjects-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--line-soft, #d0d7de);
    border-radius: 6px;
    margin-bottom: 0.9rem;
  }

  .subjects-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .subjects-table th {
    background: var(--surface-2, #f6f8fa);
    padding: 0.65rem 0.85rem;
    text-align: left;
    font-weight: 700;
    color: var(--text-strong, #1f2328);
    border-bottom: 1.5px solid var(--line-soft, #d0d7de);
  }

  .subjects-table td {
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--line-soft, #d0d7de);
    vertical-align: middle;
  }

  .subjects-table tr:last-child td {
    border-bottom: none;
  }

  .subject-name-input {
    width: 100%;
    padding: 0.4rem 0.6rem;
    font-size: 0.9rem;
    border: 1px solid var(--line-soft, #d0d7de);
    border-radius: 4px;
    background: var(--surface, #ffffff);
    color: var(--text-strong, #1f2328);
  }

  .subject-credit-input {
    width: 65px;
    padding: 0.4rem 0.4rem;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
    border: 1px solid var(--line-soft, #d0d7de);
    border-radius: 4px;
    background: var(--surface, #ffffff);
    color: var(--text-strong, #1f2328);
  }

  .subject-cost-cell {
    font-weight: 700;
    color: var(--focus-strong, #0856b3);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .btn-remove-subject {
    background: none;
    border: 1px solid transparent;
    color: var(--code-color, #cf222e);
    font-size: 1.2rem;
    font-weight: bold;
    cursor: pointer;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-remove-subject:hover {
    background: rgba(207, 34, 46, 0.1);
    border-color: rgba(207, 34, 46, 0.2);
  }

  .subjects-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .btn-sm {
    padding: 0.4rem 0.85rem;
    font-size: 0.85rem;
  }

  .btn-link-subtle {
    background: none;
    border: none;
    color: var(--text-faint, #6e7781);
    font-size: 0.85rem;
    cursor: pointer;
    text-decoration: underline;
  }

  .btn-link-subtle:hover {
    color: var(--code-color, #cf222e);
  }

  /* Results styling */
  .results-container {
    background: var(--surface-2, #f6f8fa);
    border: 2px solid var(--border-color, #d0d7de);
    border-radius: 10px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .result-hero-card {
    background: var(--card-bg, #ffffff);
    border: 2px solid var(--focus, #0969da);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    text-align: center;
    margin-bottom: 1.25rem;
    box-shadow: 0 4px 12px rgba(9, 105, 218, 0.08);
  }

  .hero-top-label {
    font-size: 0.92rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted, #57606a);
    margin-bottom: 0.35rem;
  }

  .hero-amount-wrap {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
  }

  .hero-amount {
    font-size: 2.75rem;
    font-weight: 900;
    line-height: 1.1;
    color: var(--focus-strong, #0856b3);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: -0.02em;
    word-break: break-all;
  }

  .hero-currency {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-strong, #1f2328);
  }

  .hero-in-words-box {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--surface-2, #f6f8fa);
    border: 1px solid var(--line-soft, #d0d7de);
    border-radius: 6px;
    padding: 0.35rem 0.85rem;
    max-width: 100%;
    flex-wrap: wrap;
    justify-content: center;
  }

  .in-words-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-faint, #6e7781);
    text-transform: uppercase;
  }

  .in-words-value {
    font-size: 0.95rem;
    font-weight: 600;
    font-style: italic;
    color: var(--text-strong, #1f2328);
  }

  /* Metrics grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .metric-card {
    background: var(--surface, #ffffff);
    border: 1px solid var(--line-soft, #d0d7de);
    border-radius: 8px;
    padding: 0.9rem;
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .metric-icon-box {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-2, #f6f8fa);
    border: 1px solid var(--line-soft, #d0d7de);
    border-radius: 6px;
    flex-shrink: 0;
  }

  .metric-svg {
    width: 20px;
    height: 20px;
    color: var(--focus, #0969da);
  }

  .metric-body {
    flex: 1;
    min-width: 0;
  }

  .metric-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-faint, #6e7781);
    margin-bottom: 0.2rem;
  }

  .metric-value {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-strong, #1f2328);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .metric-sub {
    font-size: 0.72rem;
    color: var(--text-muted, #57606a);
    margin-top: 0.15rem;
  }

  /* Calculation breakdown */
  .calculation-breakdown {
    background: var(--surface, #ffffff);
    border: 1px solid var(--line-soft, #d0d7de);
    border-radius: 8px;
    padding: 0.85rem 1.1rem;
    margin-bottom: 1.25rem;
    font-size: 0.88rem;
  }

  .breakdown-title {
    font-weight: 700;
    color: var(--text-strong, #1f2328);
    margin-bottom: 0.4rem;
  }

  .breakdown-steps {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .breakdown-step code {
    background: var(--surface-2, #f6f8fa);
    border: 1px solid var(--line-soft, #d0d7de);
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: var(--text-strong, #1f2328);
    display: inline-block;
    word-break: break-all;
  }

  /* Actions */
  .calc-action-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* FAQ section */
  .info-section {
    margin-top: 2rem;
  }

  .faq-cards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }

  .faq-card {
    background: var(--surface, #ffffff);
    border: 1.5px solid var(--border-color, #d0d7de);
    border-radius: 8px;
    padding: 1.2rem;
  }

  .faq-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--text-strong, #1f2328);
    margin-top: 0;
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }

  .faq-text {
    font-size: 0.88rem;
    color: var(--text-body, #24292f);
    margin: 0;
    line-height: 1.55;
  }

  /* ========================================================
     RESPONSIVE DIZAYN (PLANSHET VA TELEFONLAR UCHUN MAXSUS)
     ======================================================== */
  @media (max-width: 768px) {
    .calc-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.65rem;
    }

    .faq-cards-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    /* Tashqi qirralar va sarlavha */
    .credit-calculator-section {
      padding: 1rem 0.75rem;
      border-radius: 8px;
      margin-bottom: 1.25rem;
    }

    .calc-header {
      margin-bottom: 1.1rem;
    }

    .page-title.calc-title {
      font-size: 1.25rem;
      line-height: 1.3;
      gap: 0.5rem;
    }

    .title-svg {
      width: 22px;
      height: 22px;
    }

    .page-lead {
      font-size: 0.86rem;
      line-height: 1.5;
    }

    /* Formula banner telefonda */
    .formula-banner {
      padding: 0.85rem 0.75rem;
      margin-bottom: 1.15rem;
    }

    .formula-banner-top {
      font-size: 0.78rem;
      margin-bottom: 0.5rem;
    }

    .formula-scroll-wrap {
      padding: 0.2rem 0 0.45rem;
    }

    .formula-visual {
      font-size: 0.85rem;
      gap: 0.5rem;
    }

    .formula-side-lhs {
      padding: 0.3rem 0.55rem;
      font-size: 0.82rem;
    }

    .formula-operator {
      font-size: 1.15rem;
    }

    .fraction-num {
      padding-bottom: 0.2rem;
      font-size: 0.82rem;
    }

    .fraction-den {
      padding-top: 0.2rem;
      font-size: 0.78rem;
    }

    .formula-example {
      font-size: 0.8rem;
      line-height: 1.45;
      margin-top: 0.5rem;
      padding-top: 0.5rem;
    }

    .formula-example-math {
      display: block;
      margin-left: 0;
      margin-top: 0.25rem;
      font-size: 0.82rem;
      padding: 0.15rem 0.4rem;
      text-align: center;
    }

    /* 1-qadam va 2-qadam kartalari */
    .input-card {
      padding: 1rem 0.75rem 0.85rem;
    }

    .step-badge {
      top: -8px;
      left: 10px;
      font-size: 0.65rem;
      padding: 0.1rem 0.45rem;
    }

    .field-label-prominent {
      font-size: 0.88rem;
      margin-bottom: 0.45rem;
    }

    .calc-input-lg {
      height: 42px;
      font-size: 1.1rem;
      padding: 0.5rem 3.5rem 0.5rem 0.65rem;
    }

    .input-addon {
      right: 10px;
      font-size: 0.85rem;
    }

    /* Preset tugmalari telefonda 2 ustunli toza to'r shaklida */
    .preset-pills {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.35rem;
    }

    .preset-pill {
      width: 100%;
      padding: 0.4rem 0.5rem;
      box-sizing: border-box;
    }

    .preset-sum {
      font-size: 0.78rem;
    }

    .preset-pill small {
      font-size: 0.66rem;
    }

    /* Kredit bazasi radio chip'lari */
    .radio-chip {
      padding: 0.45rem 0.65rem;
    }

    .chip-content strong {
      font-size: 0.85rem;
    }

    .chip-content small {
      font-size: 0.7rem;
    }

    /* 3-qadam: Tablar */
    .calc-mode-card {
      padding: 1rem 0.75rem;
      margin-bottom: 1.25rem;
    }

    .mode-tabs-header {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
      margin-bottom: 0.85rem;
    }

    .mode-tab-buttons {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.35rem;
      width: 100%;
    }

    .mode-tab {
      justify-content: center;
      padding: 0.45rem 0.35rem;
      font-size: 0.78rem;
      text-align: center;
    }

    .tab-svg {
      width: 13px;
      height: 13px;
      margin-right: 0.2rem;
    }

    /* Tezkor kiritish row */
    .quick-input-row {
      flex-direction: column;
      gap: 0.85rem;
    }

    .quick-input-wrap,
    .quick-chips-wrap {
      width: 100%;
      flex: 1 1 100%;
    }

    .btn-stepper {
      width: 38px;
      height: 38px;
      font-size: 1.2rem;
    }

    .stepper-input {
      width: 76px;
      height: 38px;
      font-size: 1.15rem;
    }

    .stepper-unit {
      font-size: 0.95rem;
    }

    /* Kredit pill tugmalari telefonda 4 ustunli toza to'r */
    .credit-preset-pills {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.35rem;
    }

    .credit-pill {
      width: 100%;
      padding: 0.4rem 0.25rem;
      font-size: 0.78rem;
      text-align: center;
      justify-content: center;
    }

    /* Fanlar ro'yxati jadvali */
    .subjects-table-wrap {
      margin-bottom: 0.75rem;
    }

    .subjects-table {
      font-size: 0.8rem;
    }

    .subjects-table th,
    .subjects-table td {
      padding: 0.45rem 0.35rem;
    }

    .subject-name-input {
      font-size: 0.8rem;
      padding: 0.3rem 0.4rem;
    }

    .subject-credit-input {
      width: 48px;
      font-size: 0.82rem;
      padding: 0.3rem 0.2rem;
    }

    .subject-cost-cell {
      font-size: 0.78rem;
      white-space: nowrap;
    }

    .btn-remove-subject {
      font-size: 1.05rem;
      padding: 0.15rem 0.35rem;
    }

    /* Natijalar paneli telefonda */
    .results-container {
      padding: 0.85rem 0.65rem;
      border-radius: 8px;
    }

    .result-hero-card {
      padding: 0.85rem 0.65rem;
      margin-bottom: 0.85rem;
    }

    .hero-top-label {
      font-size: 0.72rem;
      letter-spacing: 0.03em;
    }

    .hero-amount {
      font-size: 1.95rem;
      line-height: 1.15;
    }

    .hero-currency {
      font-size: 1.1rem;
    }

    .hero-in-words-box {
      width: 100%;
      padding: 0.35rem 0.5rem;
      gap: 0.3rem;
    }

    .in-words-label {
      font-size: 0.72rem;
    }

    .in-words-value {
      font-size: 0.82rem;
      text-align: center;
      line-height: 1.35;
    }

    /* 4 ta statistik karta: telefonda 2x2 toza grid */
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.45rem;
      margin-bottom: 0.85rem;
    }

    .metric-card {
      padding: 0.6rem 0.5rem;
      gap: 0.4rem;
      border-radius: 6px;
    }

    .metric-icon-box {
      width: 26px;
      height: 26px;
      border-radius: 4px;
    }

    .metric-svg {
      width: 14px;
      height: 14px;
    }

    .metric-label {
      font-size: 0.68rem;
    }

    .metric-value {
      font-size: 0.88rem;
    }

    .metric-sub {
      font-size: 0.64rem;
    }

    /* Bosqichma-bosqich hisob */
    .calculation-breakdown {
      padding: 0.65rem 0.65rem;
      margin-bottom: 0.85rem;
    }

    .breakdown-title {
      font-size: 0.78rem;
    }

    .breakdown-step code {
      font-size: 0.74rem;
      padding: 0.2rem 0.35rem;
      line-height: 1.4;
    }

    /* Amallar tugmalari: barmoq bilan bosish oson bo'lishi uchun 100% enli */
    .calc-action-bar {
      flex-direction: column;
      gap: 0.45rem;
      width: 100%;
    }

    .calc-action-bar .btn {
      width: 100%;
      justify-content: center;
      padding: 0.6rem 0.85rem;
      font-size: 0.86rem;
    }

    .copy-toast {
      width: 100%;
      text-align: center;
      font-size: 0.8rem;
    }

    /* FAQ kartalari */
    .faq-card {
      padding: 0.9rem;
    }

    .faq-title {
      font-size: 0.9rem;
    }

    .faq-text {
      font-size: 0.82rem;
      line-height: 1.5;
    }
  }

  @media (max-width: 360px) {
    .credit-preset-pills {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  interface SubjectItem {
    id: string;
    name: string;
    credits: number;
  }

  function setupCreditCalculator() {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

    const contractInput = $<HTMLInputElement>('contract-input');
    const contractPresets = document.querySelectorAll<HTMLButtonElement>('#contract-presets .preset-pill');
    const creditBaseRadios = document.querySelectorAll<HTMLInputElement>('input[name="credit-base"]');
    const customBaseWrap = $('custom-base-wrap');
    const customBaseInput = $<HTMLInputElement>('custom-base-input');

    const tabQuick = $('tab-quick');
    const tabSubjects = $('tab-subjects');
    const modeQuickPanel = $('mode-quick-panel');
    const modeSubjectsPanel = $('mode-subjects-panel');

    const quickCreditsInput = $<HTMLInputElement>('quick-credits-input');
    const btnCreditDec = $('btn-credit-dec');
    const btnCreditInc = $('btn-credit-inc');
    const creditPills = document.querySelectorAll<HTMLButtonElement>('.credit-pill');

    const subjectsListEl = $('subjects-list');
    const btnAddSubject = $('btn-add-subject');
    const btnResetSubjects = $('btn-reset-subjects');

    const resultTotalAmount = $('result-total-amount');
    const resultInWords = $('result-in-words');
    const resultPerCredit = $('result-per-credit');
    const resultPerCreditRaw = $('result-per-credit-raw');
    const resultTotalCredits = $('result-total-credits');
    const resultSubjectsCount = $('result-subjects-count');
    const resultTotalHours = $('result-total-hours');
    const resultPercent = $('result-percent');

    const step1El = $('breakdown-step-1');
    const step2El = $('breakdown-step-2');

    const btnCopySummary = $('btn-copy-summary');
    const btnResetAll = $('btn-reset-all');
    const calcToast = $('calc-toast');

    if (!contractInput || !resultTotalAmount) return;

    // State
    let activeMode: 'quick' | 'subjects' = 'quick';
    let subjects: SubjectItem[] = [
      { id: '1', name: 'Oliy matematika', credits: 4 },
      { id: '2', name: 'Dasturlash asoslari', credits: 6 },
    ];

    // Load state from localStorage if available
    try {
      const savedMode = localStorage.getItem('hemis_calc_mode');
      if (savedMode === 'quick' || savedMode === 'subjects') activeMode = savedMode;
      const savedSubjects = localStorage.getItem('hemis_calc_subjects');
      if (savedSubjects) {
        const parsed = JSON.parse(savedSubjects);
        if (Array.isArray(parsed) && parsed.length > 0) subjects = parsed;
      }
    } catch {
      // Ignore localStorage errors
    }

    // Number to Uzbek Words converter
    function numberToUzbekWords(num: number): string {
      const rounded = Math.round(num);
      if (isNaN(rounded) || rounded <= 0) return 'Nol soʻm';

      const units = ['', 'bir', 'ikki', 'uch', 'toʻrt', 'besh', 'olti', 'yetti', 'sakkiz', 'toʻqqiz'];
      const tens = ['', 'oʻn', 'yigirma', 'oʻttiz', 'qirq', 'ellik', 'oltmish', 'yetmish', 'sakson', 'toʻqson'];
      const scales = ['', 'ming', 'million', 'milliard', 'trillion'];

      function parseChunk(n: number): string {
        const parts: string[] = [];
        const h = Math.floor(n / 100);
        const rem = n % 100;
        const t = Math.floor(rem / 10);
        const u = rem % 10;

        if (h > 0) {
          if (h === 1) parts.push('bir yuz');
          else parts.push(units[h] + ' yuz');
        }
        if (t > 0) parts.push(tens[t]);
        if (u > 0) parts.push(units[u]);

        return parts.join(' ');
      }

      let n = rounded;
      let chunkIdx = 0;
      const resultChunks: string[] = [];

      while (n > 0) {
        const chunk = n % 1000;
        if (chunk > 0) {
          const chunkStr = parseChunk(chunk);
          const scaleStr = scales[chunkIdx] ? ' ' + scales[chunkIdx] : '';
          resultChunks.unshift(chunkStr + scaleStr);
        }
        n = Math.floor(n / 1000);
        chunkIdx++;
      }

      const text = resultChunks.join(' ').trim();
      if (!text) return 'Nol soʻm';
      return (text.charAt(0).toUpperCase() + text.slice(1)) + ' soʻm';
    }

    // Format thousands with space: 8510000 -> "8 510 000"
    function formatNumber(val: number): string {
      return Math.round(val).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
    }

    // Parse cleaned number from input
    function getCleanNumber(str: string): number {
      const cleaned = str.replace(/[^\d.]/g, '');
      const num = parseFloat(cleaned);
      return isNaN(num) ? 0 : num;
    }

    // Get current annual contract
    function getAnnualContract(): number {
      return getCleanNumber(contractInput?.value || '8510000');
    }

    // Get annual credit base (usually 60)
    function getCreditBase(): number {
      let selectedVal = '60';
      creditBaseRadios.forEach((r) => {
        if (r.checked) selectedVal = r.value;
      });

      if (selectedVal === 'custom') {
        const val = parseInt(customBaseInput?.value || '60', 10);
        return isNaN(val) || val <= 0 ? 60 : val;
      }
      return parseInt(selectedVal, 10) || 60;
    }

    // Render subjects table
    function renderSubjectsTable() {
      if (!subjectsListEl) return;
      subjectsListEl.innerHTML = '';

      const contract = getAnnualContract();
      const base = getCreditBase();
      const pricePerCredit = base > 0 ? contract / base : 0;

      subjects.forEach((sub) => {
        const tr = document.createElement('tr');
        const subCost = Math.round(sub.credits * pricePerCredit);

        tr.innerHTML = `
          <td>
            <input
              type="text"
              class="subject-name-input"
              value="${sub.name.replace(/"/g, '&quot;')}"
              placeholder="Fan nomi..."
              data-id="${sub.id}"
            />
          </td>
          <td>
            <input
              type="number"
              min="0.5"
              max="60"
              step="0.5"
              class="subject-credit-input"
              value="${sub.credits}"
              data-id="${sub.id}"
            />
          </td>
          <td class="subject-cost-cell">
            ${formatNumber(subCost)} soʻm
          </td>
          <td style="text-align: center;">
            <button type="button" class="btn-remove-subject" data-id="${sub.id}" title="Fanni oʻchirish" aria-label="Fanni oʻchirish">
              &times;
            </button>
          </td>
        `;

        subjectsListEl.appendChild(tr);
      });

      // Attach subject input listeners
      subjectsListEl.querySelectorAll<HTMLInputElement>('.subject-name-input').forEach((input) => {
        input.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const item = subjects.find((s) => s.id === id);
          if (item) {
            item.name = target.value;
            saveSubjectsState();
          }
        });
      });

      subjectsListEl.querySelectorAll<HTMLInputElement>('.subject-credit-input').forEach((input) => {
        input.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const item = subjects.find((s) => s.id === id);
          if (item) {
            const val = parseFloat(target.value);
            item.credits = isNaN(val) || val < 0 ? 0 : val;
            saveSubjectsState();
            recalculate();
          }
        });
      });

      subjectsListEl.querySelectorAll<HTMLButtonElement>('.btn-remove-subject').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = (e.target as HTMLElement).closest('.btn-remove-subject');
          const id = target?.getAttribute('data-id');
          if (id) {
            subjects = subjects.filter((s) => s.id !== id);
            saveSubjectsState();
            renderSubjectsTable();
            recalculate();
          }
        });
      });
    }

    function saveSubjectsState() {
      try {
        localStorage.setItem('hemis_calc_subjects', JSON.stringify(subjects));
      } catch {}
    }

    // Main recalculate function
    function recalculate() {
      const contract = getAnnualContract();
      const base = getCreditBase();
      const pricePerCreditRaw = base > 0 ? contract / base : 0;
      const pricePerCredit = Math.round(pricePerCreditRaw);

      let totalCredits = 0;
      let subjectsCountText = '1 ta yoʻnalish boʻyicha';

      if (activeMode === 'quick') {
        const val = parseFloat(quickCreditsInput?.value || '0');
        totalCredits = isNaN(val) || val < 0 ? 0 : val;
        subjectsCountText = 'Tezkor hisoblash';
      } else {
        totalCredits = subjects.reduce((sum, s) => sum + s.credits, 0);
        subjectsCountText = `${subjects.length} ta fan boʻyicha`;
      }

      // Exact total calculation: using exact price per credit or rounded
      const totalCostRaw = totalCredits * pricePerCreditRaw;
      const totalCost = Math.round(totalCostRaw);
      const totalHours = Math.round(totalCredits * 30);
      const percent = contract > 0 ? ((totalCost / contract) * 100).toFixed(1) : '0';

      // Update Result Elements
      if (resultTotalAmount) resultTotalAmount.textContent = formatNumber(totalCost);
      if (resultInWords) resultInWords.textContent = numberToUzbekWords(totalCost);
      if (resultPerCredit) resultPerCredit.textContent = `${formatNumber(pricePerCredit)} soʻm`;
      if (resultPerCreditRaw) resultPerCreditRaw.textContent = `Aniq: ${pricePerCreditRaw.toFixed(2)} soʻm`;
      if (resultTotalCredits) resultTotalCredits.textContent = `${totalCredits} kredit`;
      if (resultSubjectsCount) resultSubjectsCount.textContent = subjectsCountText;
      if (resultTotalHours) resultTotalHours.textContent = `${totalHours} soat`;
      if (resultPercent) resultPercent.textContent = `${percent}%`;

      // Update Breakdown
      if (step1El) {
        step1El.innerHTML = `<code>1 kredit narxi = ${formatNumber(contract)} &divide; ${base} = ${pricePerCreditRaw.toFixed(2)} soʻm (${formatNumber(pricePerCredit)} soʻm)</code>`;
      }
      if (step2El) {
        step2El.innerHTML = `<code>Jami toʻlov = ${pricePerCreditRaw.toFixed(2)} &times; ${totalCredits} kredit = <strong>${formatNumber(totalCost)} soʻm</strong></code>`;
      }

      // If in subjects mode, update table cell values without re-rendering inputs
      if (activeMode === 'subjects' && subjectsListEl) {
        const costCells = subjectsListEl.querySelectorAll('.subject-cost-cell');
        subjects.forEach((sub, idx) => {
          if (costCells[idx]) {
            costCells[idx].textContent = `${formatNumber(Math.round(sub.credits * pricePerCreditRaw))} soʻm`;
          }
        });
      }
    }

    // Switch mode
    function setMode(mode: 'quick' | 'subjects') {
      activeMode = mode;
      try {
        localStorage.setItem('hemis_calc_mode', mode);
      } catch {}

      if (mode === 'quick') {
        tabQuick?.classList.add('active');
        tabQuick?.setAttribute('aria-selected', 'true');
        tabSubjects?.classList.remove('active');
        tabSubjects?.setAttribute('aria-selected', 'false');
        if (modeQuickPanel) modeQuickPanel.style.display = 'block';
        if (modeSubjectsPanel) modeSubjectsPanel.style.display = 'none';
      } else {
        tabSubjects?.classList.add('active');
        tabSubjects?.setAttribute('aria-selected', 'true');
        tabQuick?.classList.remove('active');
        tabQuick?.setAttribute('aria-selected', 'false');
        if (modeSubjectsPanel) modeSubjectsPanel.style.display = 'block';
        if (modeQuickPanel) modeQuickPanel.style.display = 'none';
        renderSubjectsTable();
      }
      recalculate();
    }

    tabQuick?.addEventListener('click', () => setMode('quick'));
    tabSubjects?.addEventListener('click', () => setMode('subjects'));

    // Contract input formatting on blur / input
    contractInput.addEventListener('input', () => {
      const current = getCleanNumber(contractInput.value);
      contractPresets.forEach((p) => {
        const amt = parseFloat(p.getAttribute('data-amount') || '0');
        if (amt === current) p.classList.add('active');
        else p.classList.remove('active');
      });
      recalculate();
    });

    contractInput.addEventListener('blur', () => {
      const current = getCleanNumber(contractInput.value);
      if (current > 0) {
        contractInput.value = formatNumber(current);
      }
    });

    // Preset pills click
    contractPresets.forEach((pill) => {
      pill.addEventListener('click', () => {
        contractPresets.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        const amt = parseFloat(pill.getAttribute('data-amount') || '8510000');
        contractInput.value = formatNumber(amt);
        recalculate();
      });
    });

    // Credit base radio changes
    creditBaseRadios.forEach((radio) => {
      radio.addEventListener('change', () => {
        if (radio.value === 'custom') {
          if (customBaseWrap) customBaseWrap.style.display = 'flex';
        } else {
          if (customBaseWrap) customBaseWrap.style.display = 'none';
        }
        recalculate();
      });
    });

    customBaseInput?.addEventListener('input', recalculate);

    // Quick Stepper
    btnCreditDec?.addEventListener('click', () => {
      if (!quickCreditsInput) return;
      const cur = parseFloat(quickCreditsInput.value) || 0;
      if (cur > 0.5) {
        quickCreditsInput.value = (cur - 1 > 0 ? cur - 1 : 0.5).toString();
        updateCreditPillActive();
        recalculate();
      }
    });

    btnCreditInc?.addEventListener('click', () => {
      if (!quickCreditsInput) return;
      const cur = parseFloat(quickCreditsInput.value) || 0;
      quickCreditsInput.value = (cur + 1).toString();
      updateCreditPillActive();
      recalculate();
    });

    quickCreditsInput?.addEventListener('input', () => {
      updateCreditPillActive();
      recalculate();
    });

    function updateCreditPillActive() {
      const val = parseFloat(quickCreditsInput?.value || '0');
      creditPills.forEach((p) => {
        const pVal = parseFloat(p.getAttribute('data-credit') || '0');
        if (pVal === val) p.classList.add('active');
        else p.classList.remove('active');
      });
    }

    creditPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const val = pill.getAttribute('data-credit');
        if (val && quickCreditsInput) {
          quickCreditsInput.value = val;
          creditPills.forEach((p) => p.classList.remove('active'));
          pill.classList.add('active');
          recalculate();
        }
      });
    });

    // Subject Add / Reset
    btnAddSubject?.addEventListener('click', () => {
      const newId = (Date.now() + Math.random()).toString();
      subjects.push({
        id: newId,
        name: `Yangi fan #${subjects.length + 1}`,
        credits: 4,
      });
      saveSubjectsState();
      renderSubjectsTable();
      recalculate();
    });

    btnResetSubjects?.addEventListener('click', () => {
      if (confirm('Barcha fanlar roʻyxatini tozalashni xohlaysizmi?')) {
        subjects = [];
        saveSubjectsState();
        renderSubjectsTable();
        recalculate();
      }
    });

    // Reset All
    btnResetAll?.addEventListener('click', () => {
      contractInput.value = '8 510 000';
      contractPresets.forEach((p) => {
        if (p.getAttribute('data-amount') === '8510000') p.classList.add('active');
        else p.classList.remove('active');
      });

      creditBaseRadios.forEach((r) => {
        r.checked = r.value === '60';
      });
      if (customBaseWrap) customBaseWrap.style.display = 'none';

      if (quickCreditsInput) quickCreditsInput.value = '6';
      creditPills.forEach((p) => {
        if (p.getAttribute('data-credit') === '6') p.classList.add('active');
        else p.classList.remove('active');
      });

      subjects = [
        { id: '1', name: 'Oliy matematika', credits: 4 },
        { id: '2', name: 'Dasturlash asoslari', credits: 6 },
      ];
      saveSubjectsState();

      setMode('quick');
      recalculate();
    });

    // Copy Summary to Clipboard
    btnCopySummary?.addEventListener('click', () => {
      const contract = getAnnualContract();
      const base = getCreditBase();
      const pricePerCredit = Math.round(base > 0 ? contract / base : 0);

      let totalCredits = 0;
      let breakdownText = '';

      if (activeMode === 'quick') {
        totalCredits = parseFloat(quickCreditsInput?.value || '0');
      } else {
        totalCredits = subjects.reduce((sum, s) => sum + s.credits, 0);
        breakdownText = '\nFanlar roʻyxati:\n' + subjects.map((s, idx) => {
          const cost = Math.round(s.credits * (contract / base));
          return `  ${idx + 1}. ${s.name}: ${s.credits} kredit (${formatNumber(cost)} soʻm)`;
        }).join('\n') + '\n';
      }

      const totalCost = Math.round(totalCredits * (contract / base));
      const inWords = numberToUzbekWords(totalCost);
      const hours = Math.round(totalCredits * 30);

      const summary = `OTM HEMIS Kredit-Modul Toʻlov Hisobi:
• Yillik kontrakt (stipendiyasiz): ${formatNumber(contract)} soʻm
• 1 oʻquv yili kredit hajmi: ${base} kredit
• 1 kredit qiymati: ${formatNumber(pricePerCredit)} soʻm
• Qarzdorlik hajmi: ${totalCredits} kredit (${hours} soat oʻquv yuklamasi)${breakdownText}
JAMI TOʻLOV SUMMASI: ${formatNumber(totalCost)} soʻm
Soʻz bilan: ${inWords}

Hisoblandi: ${window.location.href}`;

      navigator.clipboard.writeText(summary).then(() => {
        if (calcToast) {
          calcToast.style.display = 'inline';
          setTimeout(() => {
            calcToast.style.display = 'none';
          }, 3000);
        }
      });
    });

    // Initial setup
    renderSubjectsTable();
    setMode(activeMode);
    updateCreditPillActive();
    recalculate();
  }

  document.addEventListener('astro:page-load', setupCreditCalculator);
</script>
