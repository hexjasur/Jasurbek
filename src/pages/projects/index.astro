---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const projects = [
  {
    title: 'Yolnoma-App',
    eyebrow: 'Desktop application',
    description: 'A Tauri-powered desktop workspace that brings developer, network, media, image, AI, and gaming utilities into one practical application.',
    details: [
      'React, TypeScript, Vite and Tailwind CSS frontend',
      'Tauri v2 and Rust native desktop layer',
      'Local-first account and AI chat session storage',
      'Developer tools, network inspection and media workflows'
    ],
    website: 'https://app.yolnoma.uz',
    repository: 'https://github.com/hexjasur/Yolnoma-App',
    image: `${baseUrl}images/projects/yolnoma-app/yolnoma-brand.jpg`,
    imageAlt: 'Yolnoma desktop workspace preview',
    screenshots: [
      { src: `${baseUrl}images/projects/yolnoma-app/yolnoma-dashboard.png`, alt: 'Yolnoma dashboard screenshot' },
      { src: `${baseUrl}images/projects/yolnoma-app/yolnoma-workspace.png`, alt: 'Yolnoma developer workspace screenshot' }
    ]
  },
  {
    title: 'Numeric Methods',
    eyebrow: 'Web, desktop and Android',
    description: 'An interactive laboratory for numerical methods and computational mathematics, designed to explain algorithms step by step.',
    details: [
      'Next.js 16, React 19 and Tailwind CSS 4',
      'Tauri v2 builds for Windows, Linux and Android',
      'Bisection, Newton, interpolation, quadrature and ODE solvers',
      'Interactive charts, formulas, audit tables and export tools'
    ],
    website: 'https://sonli-usullar.uz',
    repository: 'https://github.com/hexjasur/numeric-methods',
    image: `${baseUrl}images/projects/nm/numeric-methods-main.png`,
    imageAlt: 'Numeric Methods application preview',
    screenshots: [
      { src: `${baseUrl}images/projects/nm/numeric-methods-home.png`, alt: 'Numeric Methods calculating state preview' },
      { src: `${baseUrl}images/projects/nm/numeric-methods-ode.png`, alt: 'Numeric Methods ODE solver preview' }
    ]
  },
  {
    title: 'AGENTS.md',
    eyebrow: 'Developer documentation',
    description: 'A focused repository for installing and updating AGENTS.md instructions used by AI coding agents across software projects.',
    details: [
      'Documents repeatable agent instructions and project conventions',
      'Helps teams keep AI-assisted coding workflows consistent',
      'A documentation and engineering-process project rather than a visual app'
    ],
    image: `${baseUrl}images/projects/agents-md/agents-md-readme.png`,
    repository: 'https://github.com/hexjasur/AGENTS.md',
    imageAlt: 'AGENTS.md documentation project placeholder'
  }
];
---

<Layout
  title={`Projects | ${SITE_CONFIG.author}`}
  description="Explore Jasurbek Haydarov's software projects, including Tauri desktop applications, numerical computing tools, and developer resources."
  activePage="projects"
  headerTitle={SITE_CONFIG.domain}
>
  <section class="projects-intro">
    <p class="eyebrow">Selected work</p>
    <h2>Projects by {SITE_CONFIG.author}</h2>
    <p>
      A selection of software and documentation projects covering native desktop applications,
      computational mathematics, developer tooling, and AI-assisted engineering workflows.
    </p>
  </section>

  <div class="projects-list">
    {projects.map((project) => (
      <article class="project-card">
        <div class="project-card-copy">
          <p class="project-eyebrow">{project.eyebrow}</p>
          <h3>{project.title}</h3>
          <p class="project-description">{project.description}</p>
          <ul class="project-details">
            {project.details.map((detail) => <li>{detail}</li>)}
          </ul>
          <div class="project-links">
            {project.website && <a class="btn" href={project.website} target="_blank" rel="noopener noreferrer">Open website</a>}
            <a class="btn btn-secondary" href={project.repository} target="_blank" rel="noopener noreferrer">View repository</a>
          </div>
        </div>
        <div class:list={["project-media", { "project-media-placeholder": !project.image }]}>
          {project.image ? (
            <img src={project.image} alt={project.imageAlt} loading="lazy" />
          ) : (
            <div class="project-placeholder-content">
              <span class="project-placeholder-mark">AGENTS.md</span>
              <span>Documentation repository</span>
            </div>
          )}
        </div>
        {project.screenshots && (
          <div class="project-screenshots" aria-label={`${project.title} screenshots`}>
            {project.screenshots.map((screenshot) => (
              <img src={screenshot.src} alt={screenshot.alt} loading="lazy" />
            ))}
          </div>
        )}
      </article>
    ))}
  </div>

  <p class="projects-note">
    Screenshots are sourced from the linked project repositories. Visit each repository for releases,
    installation instructions, source code, and the latest updates.
  </p>
</Layout>
