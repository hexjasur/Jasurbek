---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../config';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const projects = [
  {
    slug: 'numeric-methods',
    title: 'Numeric Methods',
    eyebrow: 'Web, desktop and Android',
    tagline: 'Interactive algorithms. Step-by-step computation. Cross-platform.',
    description: 'An interactive laboratory for numerical methods and computational mathematics, designed to explain algorithms step by step with live charts, formula inspectors, and native binaries for Windows, Linux, and Android.',
    tags: ['Next.js 16', 'React 19', 'Tailwind CSS 4', 'Tauri v2', 'Rust'],
    image: `${baseUrl}images/projects/nm/numeric-methods-main.webp`,
    imageAlt: 'Numeric Methods application preview',
    featured: true,
    hasDownloads: true,
    year: '2025–Present',
    status: 'Active',
    website: 'https://sonli-usullar.uz',
    repository: 'https://github.com/hexjasur/numeric-methods',
  },
  {
    slug: 'yolnoma-app',
    title: 'Yolnoma-App',
    eyebrow: 'Desktop application',
    tagline: 'Developer workspace. Unified utilities. Tauri-powered.',
    description: 'A Tauri-powered desktop workspace that unifies developer utilities, network tools, media conversion, and local-first AI chat sessions into one lightweight native application.',
    tags: ['React', 'TypeScript', 'Tauri v2', 'Rust', 'Vite', 'Tailwind CSS'],
    image: `${baseUrl}images/projects/yolnoma-app/yolnoma-brand.webp`,
    imageAlt: 'Yolnoma desktop workspace preview',
    featured: true,
    hasDownloads: false,
    year: '2025–Present',
    status: 'Active',
    website: 'https://app.yolnoma.uz',
    repository: 'https://github.com/hexjasur/Yolnoma-App',
  },
  {
    slug: 'agents-md',
    title: 'AGENTS.md',
    eyebrow: 'Developer documentation & tooling',
    tagline: 'AI agent instructions. Consistent workflows. Team standards.',
    description: 'A focused open-source repository and documentation standard for defining reproducible conventions, instructions, and workflows for autonomous AI coding agents across teams.',
    tags: ['Documentation', 'AI Coding', 'Engineering Standards', 'Open Source'],
    image: `${baseUrl}images/projects/agents-md/agents-md-readme.webp`,
    imageAlt: 'AGENTS.md documentation project',
    featured: false,
    hasDownloads: false,
    year: '2025',
    status: 'Maintained',
    repository: 'https://github.com/hexjasur/AGENTS.md',
  },
];

const imageSizes: Record<string, [number, number]> = {
  'yolnoma-brand.webp': [1200, 675],
  'numeric-methods-main.webp': [1200, 600],
  'agents-md-readme.webp': [817, 696],
};
const sizeOf = (src: string) => imageSizes[src.split('/').pop() ?? ''] ?? [1200, 675];
---

<Layout
  title={`Projects & Software | ${SITE_CONFIG.author}`}
  description="Explore Jasurbek Haydarov's software projects, including Tauri desktop applications, numerical computing laboratories, and developer tooling."
  activePage="projects"
  headerTitle={SITE_CONFIG.domain}
>
  <!-- Minimalist Header matching Tools page -->
  <div class="blog-intro">
    <h2 class="page-title">
      Featured Projects & Software | {SITE_CONFIG.domain}
    </h2>
    <div class="blog-meta-date">Category: Native Desktop, Computational Mathematics & Open Source</div>
    <div class="blog-meta-date">Total: {projects.length} Active Projects • Cross-Platform</div>

    <p class="blog-desc">
      Focused applications and developer tools built with intentionality — spanning cross-platform Tauri workspaces, numerical mathematics engines, and engineering workflows.
    </p>
  </div>

  <h3 class="blog-entries-title section-gap">Selected Work</h3>

  <!-- Clean, Balanced Project Cards -->
  <div class="projects-list">
    {projects.map((project, index) => (
      <article class="project-entry-card">
        <div class="project-card-image-wrap">
          <a href={`${baseUrl}projects/${project.slug}`} class="project-image-link" tabindex="-1" aria-hidden="true">
            <img
              src={project.image}
              alt={project.imageAlt}
              width={sizeOf(project.image)[0]}
              height={sizeOf(project.image)[1]}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class="project-img"
            />
          </a>
          <div class="project-badge-row">
            <span class="project-year-badge">{project.year}</span>
            <span class="project-status-badge">{project.status}</span>
          </div>
        </div>

        <div class="project-card-info">
          <div class="project-header-line">
            <span class="project-eyebrow">{project.eyebrow}</span>
            <span class="project-num">0{index + 1}.</span>
          </div>

          <h4 class="project-title">
            <a href={`${baseUrl}projects/${project.slug}`} class="project-title-link">
              {project.title}
            </a>
          </h4>

          <p class="project-tagline">{project.tagline}</p>

          <p class="project-desc">{project.description}</p>

          <div class="project-tags">
            {project.tags.map(tag => (
              <span class="project-tag-chip">{tag}</span>
            ))}
          </div>

          <div class="project-actions">
            <a href={`${baseUrl}projects/${project.slug}`} class="btn btn-primary">
              <span>View Details</span>
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </a>

            {project.hasDownloads && (
              <a href={`${baseUrl}projects/${project.slug}#downloads`} class="btn btn-download">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>Downloads</span>
              </a>
            )}

            {project.website && (
              <a href={project.website} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
                <span>Live ↗</span>
              </a>
            )}

            {project.repository && (
              <a href={project.repository} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
                <span>Source ↗</span>
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</Layout>

<style>
  /* Section Gap */
  .section-gap {
    margin-top: 2rem;
    margin-bottom: 1.25rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
    font-family: Georgia, "Times New Roman", serif;
  }

  /* Projects List */
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* Project Card */
  .project-entry-card {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 1.75rem;
    background: var(--card-bg, var(--surface, #fff));
    border: 2px solid var(--border-color, #2e2e2e);
    border-radius: 12px;
    box-shadow: 4px 4px 0 var(--card-shadow-color, rgba(0,0,0,0.15));
    padding: 1.35rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    align-items: center;
  }

  .project-entry-card:hover {
    transform: translate(-2px, -2px);
    border-color: var(--flora-orange, #b86752);
    box-shadow: 6px 6px 0 var(--card-shadow-color, rgba(0,0,0,0.25));
  }

  /* Image Wrap */
  .project-card-image-wrap {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    border: 1.5px solid var(--border-color, #2e2e2e);
    aspect-ratio: 16 / 10;
    background: var(--surface-2, #f5efe6);
  }

  .project-image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .project-entry-card:hover .project-img {
    transform: scale(1.03);
  }

  .project-badge-row {
    position: absolute;
    bottom: 0.6rem;
    left: 0.6rem;
    display: flex;
    gap: 0.4rem;
  }

  .project-year-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    background: rgba(28, 38, 33, 0.88);
    color: #fff;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .project-status-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    background: var(--flora-sage, #c7d2b1);
    color: var(--text-main, #1c2621);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  /* Card Info */
  .project-card-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .project-header-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.35rem;
  }

  .project-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    font-family: var(--font-mono, monospace);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--flora-orange, #b86752);
  }

  .project-num {
    font-family: var(--font-mono, monospace);
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--text-faint, #999);
  }

  .project-title {
    margin: 0 0 0.35rem;
    font-size: 1.35rem;
    font-weight: 700;
    font-family: Georgia, "Times New Roman", serif;
  }

  .project-title-link {
    color: var(--text-main, #1c2621);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .project-title-link:hover {
    color: var(--flora-orange, #b86752);
  }

  .project-tagline {
    margin: 0 0 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    font-family: var(--font-mono, monospace);
    color: var(--text-soft, #555);
  }

  .project-desc {
    margin: 0 0 0.85rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-soft, #444);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.15rem;
  }

  .project-tag-chip {
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    padding: 0.15rem 0.5rem;
    background: var(--surface-2, rgba(0,0,0,0.05));
    border: 1px solid var(--line-soft, rgba(0,0,0,0.1));
    border-radius: 4px;
    color: var(--text-strong, #222);
  }

  /* Actions */
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.95rem;
    font-size: 0.84rem;
    font-weight: 700;
    font-family: var(--font-mono, monospace);
    border-radius: 7px;
    border: 2px solid var(--border-color, #2e2e2e);
    text-decoration: none;
    transition: all 0.15s ease;
    box-shadow: 2px 2px 0 var(--card-shadow-color, rgba(0,0,0,0.15));
  }

  .btn-primary {
    background: var(--flora-sage, #c7d2b1);
    color: var(--text-main, #1c2621);
  }

  .btn-primary:hover {
    background: var(--sage-hover, #b8c59f);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--card-shadow-color);
    text-decoration: none;
  }

  .btn-download {
    background: var(--chip-bg, #f3ede2);
    color: var(--text-main, #1c2621);
    border-color: var(--flora-orange, #b86752);
  }

  .btn-download:hover {
    background: var(--flora-orange, #b86752);
    color: #fff;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--card-shadow-color);
    text-decoration: none;
  }

  .btn-ghost {
    background: var(--surface, #fff);
    color: var(--text-main, #1c2621);
  }

  .btn-ghost:hover {
    background: var(--bg-hover, #f3ede2);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--card-shadow-color);
    text-decoration: none;
  }

  /* ===== Responsive ===== */
  @media (max-width: 860px) {
    .project-entry-card {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .project-card-image-wrap {
      max-height: 280px;
    }
  }
</style>
