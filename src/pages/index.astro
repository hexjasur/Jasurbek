---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../config';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title={`${SITE_CONFIG.author} - Profile / Biography`} 
  activePage="profile" 
  headerTitle={`${SITE_CONFIG.author} - Profile / Biography`}
>
  <div class="profile-layout">
    <aside class="profile-sidebar">
      <img src={`${baseUrl}images/jasur-flora.png`} alt={SITE_CONFIG.author} class="profile-avatar" />
      <div class="profile-socials">
        <a href={SITE_CONFIG.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={SITE_CONFIG.telegram} target="_blank" rel="noopener noreferrer">Telegram</a>
        <a href="https://steamcommunity.com/id/ROCKSTAR_TTV" target="_blank" rel="noopener noreferrer">Steam</a>
        <a href="#" class="email-trigger" title="Click to view Email">Email</a>
      </div>
    </aside>

    <div class="profile-main">
      <h2>About <strong>{SITE_CONFIG.author}</strong></h2>
      
      <p>
        Hi, I'm Jasurbek Haydarov — a developer who enjoys building things, exploring new technologies, and learning how things work.
      </p>

      <p>
        I mainly work with JavaScript and TypeScript, using tools like React and Node.js to create web applications. I also enjoy working on desktop apps, trying out new libraries, and building small tools that make everyday tasks easier.
      </p>

      <p>
        I spend most of my time learning through personal projects. I like starting with an idea, experimenting with different approaches, and seeing where it leads. Not everything has to be a big project — sometimes even a small experiment can teach me something new.
      </p>

      <p>
        This website is where I share my projects, experiments, and things I've learned along the way. It's a little collection of what I do, what I enjoy, and what I'm currently exploring.
      </p>
    </div>
  </div>
</Layout>
