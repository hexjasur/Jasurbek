---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../config';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title={`${SITE_CONFIG.author} - Profile & Biography`} 
  description="Meet Jasurbek Haydarov — software engineer exploring TypeScript, React, Tauri desktop workspaces, computational systems, and Flora design aesthetics."
  activePage="profile" 
  headerTitle={`${SITE_CONFIG.author} - Profile / Biography`}
>
  <div class="profile-v2">
    <!-- Top Decorative Banner -->
    <div class="profile-banner">
      <img
        src={`${baseUrl}images/flora/hero-banner.jpg`}
        alt="Flora vintage botanical banner"
        width="1200"
        height="350"
        fetchpriority="high"
        decoding="async"
        class="banner-img"
      />
      <div class="banner-gradient"></div>
      <div class="mobile-banner-portrait">
        <img
          src={`${baseUrl}images/jasur-flora.webp`}
          alt={SITE_CONFIG.author}
          width="480"
          height="640"
          decoding="async"
          class="profile-avatar"
        />
        <div class="hanko-seal" title="Jasurbek Seal (判子)">
          <span>駿</span>
        </div>
      </div>
    </div>

    <!-- Main Two-Column Layout -->
    <div class="profile-content-grid">
      <!-- Left Column: Avatar & Quick Info -->
      <aside class="profile-aside">
        <div class="avatar-frame">
          <img
            src={`${baseUrl}images/jasur-flora.webp`}
            alt={SITE_CONFIG.author}
            width="480"
            height="640"
            fetchpriority="high"
            decoding="async"
            class="profile-avatar"
          />
          <div class="hanko-seal" title="Jasurbek Seal (判子)">
            <span>駿</span>
          </div>
        </div>

        <div class="profile-identity">
          <h2 class="profile-name">{SITE_CONFIG.author}</h2>
          <p class="profile-katakana">ジャスルベック・ハイダロフ</p>
        </div>

        <div class="profile-socials-v2">
          <a href={SITE_CONFIG.github} target="_blank" rel="noopener noreferrer" class="social-chip">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            <span>GitHub</span>
          </a>
          <a href={SITE_CONFIG.telegram} target="_blank" rel="noopener noreferrer" class="social-chip">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.63 3.73-.53.37-1.02.55-1.45.54-.48-.01-1.4-.27-2.08-.49-.84-.27-1.51-.42-1.45-.89.03-.25.38-.51 1.05-.78 4.12-1.79 6.87-2.97 8.25-3.54 3.92-1.63 4.74-1.92 5.27-1.93.12 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.2-.04.35z"/></svg>
            <span>Telegram</span>
          </a>
          <a href="https://steamcommunity.com/id/ROCKSTAR_TTV" target="_blank" rel="noopener noreferrer" class="social-chip">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.005.105.005.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.733L.439 15.27C1.862 20.307 6.494 24 11.979 24c6.627 0 12-5.373 12-12s-5.373-12-12-12zm-3.613 16.545l-1.924-.796c.307.747 1.011 1.291 1.859 1.343.34-.343.432-.472.065-.547zm7.575-9.878c-1.396 0-2.533 1.137-2.533 2.533 0 1.398 1.137 2.533 2.533 2.533 1.398 0 2.533-1.135 2.533-2.533 0-1.396-1.135-2.533-2.533-2.533zm0 .845c.932 0 1.688.756 1.688 1.688s-.756 1.688-1.688 1.688-1.688-.756-1.688-1.688.756-1.688 1.688-1.688z"/></svg>
            <span>Steam</span>
          </a>
          <button type="button" class="social-chip email-trigger" title="Click to view Email">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span>Email</span>
          </button>
        </div>
      </aside>

      <!-- Right Column: Biography -->
      <main class="profile-main-v2">
        <section class="bio-section">
          <h2>About <strong>{SITE_CONFIG.author}</strong></h2>
          
          <p>
            Hi, I'm Jasurbek Haydarov — a developer who enjoys building things, exploring new technologies, and learning how things work.
          </p>

          <p>
            I mainly work with JavaScript and TypeScript, using tools like React and Node.js to create web applications. I also enjoy working on desktop apps, trying out new libraries, and building small tools that make everyday tasks easier.
          </p>

          <p>
            I spend most of my time learning through personal projects. I like starting with an idea, experimenting with different approaches, and seeing where it leads. Not everything has to be a big project — sometimes even a small experiment can teach me something new.
          </p>

          <p>
            This website is where I share my projects, experiments, and things I've learned along the way. It's a little collection of what I do, what I enjoy, and what I'm currently exploring.
          </p>
        </section>
      </main>
    </div>
  </div>
</Layout>

<style>
  .profile-v2 {
    max-width: 100%;
  }

  /* ===== Banner ===== */
  .profile-banner {
    position: relative;
    width: 100%;
    height: 180px;
    border: 2px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 2rem;
    box-shadow: 4px 4px 0 var(--card-shadow-color);
  }

  .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: saturate(0.9);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(28, 36, 48, 0.45), transparent 70%);
  }

  .mobile-banner-portrait {
    display: none;
  }

  .banner-badge {
    position: absolute;
    bottom: 0.85rem;
    right: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(251, 246, 236, 0.94);
    border: 1.5px solid var(--border-color);
    border-radius: 999px;
    box-shadow: 2px 2px 0 var(--card-shadow-color);
    backdrop-filter: blur(4px);
  }

  :root[data-theme='dark'] .banner-badge {
    background: rgba(27, 36, 32, 0.94);
  }

  .badge-kanji {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--flora-orange, #b86752);
    font-family: Georgia, serif;
  }

  .badge-sub {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-strong);
  }

  /* ===== Content Grid ===== */
  .profile-content-grid {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 2.25rem;
    align-items: start;
  }

  /* Aside / Avatar */
  .profile-aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .avatar-frame {
    position: relative;
    width: 100%;
    max-width: 200px;
    margin-bottom: 1rem;
  }

  .profile-avatar {
    width: 100%;
    aspect-ratio: 1 / 1.15;
    object-fit: cover;
    border-radius: 12px;
    border: 2.5px solid var(--border-color);
    box-shadow: 4px 4px 0 var(--card-shadow-color);
    display: block;
  }

  .hanko-seal {
    position: absolute;
    bottom: -10px;
    right: -8px;
    width: 34px;
    height: 34px;
    background: #b86752;
    border: 2px solid #8f4d3e;
    border-radius: 6px;
    display: grid;
    place-items: center;
    color: #fffaf1;
    font-size: 1.05rem;
    font-weight: 800;
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.25);
    user-select: none;
    transform: rotate(-6deg);
  }

  .profile-identity {
    margin-bottom: 1.1rem;
  }

  .profile-name {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: #b86752;
    font-family: Georgia, serif;
  }

  .profile-katakana {
    margin: 0.15rem 0 0.5rem;
    font-size: 0.75rem;
    color: var(--text-faint);
    letter-spacing: 0.04em;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    background: var(--chip-bg);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-soft);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success, #1a7f37);
    box-shadow: 0 0 0 2px rgba(26, 127, 55, 0.2);
    animation: pulse-dot 2s infinite ease-in-out;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }

  .profile-socials-v2 {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
  }

  .social-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border: 1.5px solid var(--border-color);
    border-radius: 999px;
    background: var(--chip-bg);
    color: var(--text-main);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 1.5px 1.5px 0 var(--card-shadow-color);
    transition: all 0.15s ease;
  }

  .social-chip:hover {
    background: var(--flora-sage);
    transform: translate(-1px, -1px);
    box-shadow: 2.5px 2.5px 0 var(--card-shadow-color);
    text-decoration: none;
  }

  /* ===== Main Column ===== */
  .profile-main-v2 {
    min-width: 0;
  }

  .bio-section h2 {
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 1.35rem;
    font-weight: 700;
    font-family: Georgia, "Times New Roman", serif;
    color: var(--text-strong);
  }

  .bio-section h2 strong {
    color: #b86752;
    font-weight: 700;
  }

  .bio-section p {
    margin-top: 0;
    margin-bottom: 1.25rem;
    font-size: 1.12rem;
    line-height: 1.75;
    color: var(--text-copy, var(--text-body));
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .profile-content-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .profile-aside {
      max-width: 280px;
      margin: 0 auto;
    }

    .profile-banner {
      height: 140px;
    }
  }

  @media (max-width: 600px) {
    .profile-banner {
      height: 205px;
      margin-bottom: 7rem;
      overflow: visible;
      background: var(--surface);
    }

    .profile-banner::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: inset 0 0 0 2px rgba(49, 71, 59, 0.1);
      pointer-events: none;
    }

    .mobile-banner-portrait {
      display: block;
      position: absolute;
      z-index: 2;
      left: 50%;
      bottom: -6.3rem;
      width: min(56vw, 176px);
      transform: translateX(-50%);
    }

    .mobile-banner-portrait .profile-avatar {
      aspect-ratio: 0.78;
      object-position: center 28%;
      border-width: 2.5px;
      border-radius: 14px;
      background: var(--surface);
    }

    .mobile-banner-portrait .hanko-seal {
      right: -9px;
      bottom: -9px;
    }

    .profile-aside .avatar-frame {
      display: none;
    }

    .profile-aside {
      max-width: none;
    }

    .profile-identity {
      margin-bottom: 0.85rem;
    }

    .profile-name {
      font-size: clamp(1.05rem, 5vw, 1.25rem);
    }

    .profile-socials-v2 {
      max-width: 300px;
      margin-inline: auto;
    }
  }
</style>
