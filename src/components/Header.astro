---
interface Props {
  activePage?: string;
  headerTitle?: string;
}

const { 
  activePage = '', 
  headerTitle = 'Jasurbek Haydarov - Profile / Biography' 
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;
---

<header class="site-header">
  <h1 class="site-title">{headerTitle}</h1>
</header>
<nav class="site-nav">
  <a href={baseUrl} class:list={[{ active: activePage === 'profile' }]}>Profile</a>
  <span class="sep">|</span>
  <a href={`${baseUrl}projects`} class:list={[{ active: activePage === 'projects' }]}>Projects</a>
  <span class="sep">|</span>
  <a href={`${baseUrl}blog`} class:list={[{ active: activePage === 'blog' }]}>Blog</a>
  <span class="sep">|</span>
  <a href={`${baseUrl}tools`} class:list={[{ active: activePage === 'tools' }]}>Tools</a>
</nav>
