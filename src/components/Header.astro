---
interface Props {
  activePage?: string;
  headerTitle?: string;
}

const { 
  activePage = '', 
  headerTitle = 'Jasurbek Haydarov - Profile / Biography' 
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;
---

<header class="site-header">
  <h1 class="site-title">{headerTitle}</h1>
</header>
<nav class="site-nav" aria-label="Main navigation">
  <div class="nav-links">
    <a href={baseUrl} class:list={[{ active: activePage === 'profile' }]} aria-current={activePage === 'profile' ? 'page' : undefined}>Profile</a>
    <span class="sep">|</span>
    <a href={`${baseUrl}projects`} class:list={[{ active: activePage === 'projects' }]} aria-current={activePage === 'projects' ? 'page' : undefined}>Projects</a>
    <span class="sep">|</span>
    <a href={`${baseUrl}blog`} class:list={[{ active: activePage === 'blog' }]} aria-current={activePage === 'blog' ? 'page' : undefined}>Blog</a>
    <span class="sep">|</span>
    <a href={`${baseUrl}tools`} class:list={[{ active: activePage === 'tools' }]} aria-current={activePage === 'tools' ? 'page' : undefined}>Tools</a>
    <span class="sep">|</span>
    <a href={`${baseUrl}playground`} class:list={[{ active: activePage === 'playground' }]} aria-current={activePage === 'playground' ? 'page' : undefined}>Playground</a>
    <span class="sep">|</span>
    <a href={`${baseUrl}contact`} class:list={[{ active: activePage === 'contact' }]} aria-current={activePage === 'contact' ? 'page' : undefined}>Contact</a>
  </div>
  <div class="nav-actions">
    <button type="button" class="theme-toggle search-trigger" data-search-open aria-label="Search the site (Ctrl+K)" title="Search (Ctrl+K or /)">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="10.8" cy="10.8" r="6.3" />
        <path d="m15.4 15.4 4.1 4.1" />
      </svg>
    </button>
    <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Switch to dark mode" title="Toggle dark mode">
      <svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
      <svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
    </button>
  </div>
</nav>
