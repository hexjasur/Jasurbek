---
// Accessible custom dropdown (button + listbox) to replace a native <select> where the
// browser's default select styling doesn't match the rest of a tool's UI.
//
// Usage:
//   <CustomSelect id="ps-strategy" options={[{ value: 'mobile', label: 'Mobile' }, ...]} value="mobile" ariaLabel="Device" />
//
// Read the current value from script with:
//   document.getElementById('ps-strategy')?.closest('[data-custom-select]')?.dataset.value
// or listen for the `customselect:change` event, which bubbles and carries `detail.value`.

export interface SelectOption {
  value: string;
  label: string;
}

interface Props {
  id: string;
  options: SelectOption[];
  value?: string;
  ariaLabel?: string;
}

const { id, options, value, ariaLabel } = Astro.props;
const initial = options.find((o) => o.value === value) ?? options[0];
const listboxId = `${id}-listbox`;
---

<div class="custom-select" data-custom-select data-value={initial?.value}>
  <button
    type="button"
    id={id}
    class="custom-select-trigger"
    role="combobox"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={listboxId}
    aria-label={ariaLabel}
  >
    <span class="custom-select-value">{initial?.label}</span>
    <svg class="custom-select-caret" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
  <ul id={listboxId} class="custom-select-listbox" role="listbox" tabindex="-1" aria-labelledby={id} hidden>
    {options.map((opt) => (
      <li
        role="option"
        class="custom-select-option"
        data-value={opt.value}
        aria-selected={opt.value === initial?.value ? 'true' : 'false'}
        tabindex="-1"
      >
        {opt.label}
      </li>
    ))}
  </ul>
</div>

<script>
  function setupCustomSelects() {
    document.querySelectorAll<HTMLElement>('[data-custom-select]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';

      const trigger = root.querySelector<HTMLButtonElement>('.custom-select-trigger');
      const listbox = root.querySelector<HTMLUListElement>('.custom-select-listbox');
      const valueLabel = root.querySelector<HTMLElement>('.custom-select-value');
      const options = Array.from(root.querySelectorAll<HTMLLIElement>('.custom-select-option'));
      if (!trigger || !listbox || !valueLabel || options.length === 0) return;

      function currentIndex() {
        return options.findIndex((o) => o.getAttribute('aria-selected') === 'true');
      }

      function onDocClick(e: MouseEvent) {
        if (!root.contains(e.target as Node)) close();
      }

      function open() {
        if (!listbox || !trigger) return;
        listbox.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        const idx = Math.max(currentIndex(), 0);
        options[idx]?.focus();
        document.addEventListener('click', onDocClick);
      }

      function close(focusTrigger = false) {
        if (!listbox || !trigger) return;
        listbox.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
        document.removeEventListener('click', onDocClick);
        if (focusTrigger) trigger.focus();
      }

      function select(option: HTMLLIElement) {
        if (!valueLabel) return;
        options.forEach((o) => o.setAttribute('aria-selected', o === option ? 'true' : 'false'));
        valueLabel.textContent = option.textContent ?? '';
        root.dataset.value = option.dataset.value ?? '';
        root.dispatchEvent(new CustomEvent('customselect:change', { detail: { value: root.dataset.value }, bubbles: true }));
      }

      trigger.addEventListener('click', () => {
        if (listbox!.hidden) open(); else close();
      });

      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open();
        } else if (e.key === 'Escape') {
          close();
        }
      });

      options.forEach((option, idx) => {
        option.addEventListener('click', () => {
          select(option);
          close(true);
        });
        option.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            select(option);
            close(true);
          } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            (options[idx + 1] ?? options[0]).focus();
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            (options[idx - 1] ?? options[options.length - 1]).focus();
          } else if (e.key === 'Escape') {
            close(true);
          } else if (e.key === 'Tab') {
            close();
          }
        });
      });
    });
  }

  document.addEventListener('astro:page-load', setupCustomSelects);
</script>

<style>
  .custom-select {
    position: relative;
    display: inline-block;
  }

  .custom-select-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    min-width: 9.5rem;
    border: 1.5px solid var(--line-soft);
    border-radius: 4px;
    padding: 0.5rem 0.85rem;
    font-size: 0.95rem;
    font-family: inherit;
    background: var(--surface);
    color: var(--text-strong);
    cursor: pointer;
  }

  .custom-select-trigger:hover {
    border-color: var(--focus);
  }

  .custom-select-trigger:focus-visible,
  .custom-select-option:focus-visible {
    outline: none;
    border-color: var(--focus);
    box-shadow: 0 0 0 3px rgba(9, 105, 218, 0.15);
  }

  .custom-select-caret {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--text-soft);
    transition: transform 0.15s;
  }

  .custom-select-trigger[aria-expanded='true'] .custom-select-caret {
    transform: rotate(180deg);
  }

  .custom-select-listbox {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.35rem);
    left: 0;
    min-width: 100%;
    margin: 0;
    padding: 0.3rem;
    list-style: none;
    border: 1.5px solid var(--line-soft);
    border-radius: 6px;
    background: var(--surface);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.16);
    max-height: 14rem;
    overflow-y: auto;
  }

  .custom-select-option {
    padding: 0.5rem 0.7rem;
    border-radius: 4px;
    font-size: 0.95rem;
    cursor: pointer;
    color: var(--text-strong);
    white-space: nowrap;
  }

  .custom-select-option:hover {
    background: var(--line-soft);
  }

  .custom-select-option[aria-selected='true'] {
    font-weight: 600;
    color: var(--focus);
  }
</style>
