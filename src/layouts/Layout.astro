---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE_CONFIG } from '../config';
import { toolsList } from '../data/tools';
import { absoluteUrl } from '../lib/url';
import {
  breadcrumbSchema,
  personSchema,
  webAppSchema,
  websiteSchema,
  type Crumb,
  type SchemaNode,
} from '../lib/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
  headerTitle?: string;
  /** Site-relative OG image path. Derived from the route when omitted. */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  tags?: string[];
  noindex?: boolean;
  /** Include this page in the on-site search index (Pagefind). */
  searchable?: boolean;
  /** Extra schema.org nodes (e.g. BlogPosting) merged into the page's JSON-LD graph. */
  schema?: SchemaNode | SchemaNode[];
}

const { 
  title, 
  description = SITE_CONFIG.description, 
  activePage = '',
  headerTitle,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags,
  noindex = false,
  searchable = true,
  schema,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;
const basePath = baseUrl.replace(/\/$/, '');
const pagePath = Astro.url.pathname;
const canonicalPath = pagePath === basePath
  ? baseUrl
  : pagePath.startsWith(`${basePath}/`)
    ? pagePath
    : `${baseUrl}${pagePath.replace(/^\/+/, '')}`;
const canonicalUrl = new URL(canonicalPath, Astro.site);

// Map a route to its generated OG image (see src/pages/og/[...slug].png.ts).
const routeKey = canonicalPath.slice(baseUrl.length).replace(/\/+$/, '');
const knownOgRoutes = ['blog', 'projects', 'tools'];
const derivedImage =
  routeKey === ''
    ? SITE_CONFIG.defaultOgImage
    : knownOgRoutes.includes(routeKey) || /^(blog|tools)\/[^/]+$/.test(routeKey)
      ? `og/${routeKey}.png`
      : SITE_CONFIG.defaultOgImage;
const ogImage = image ?? derivedImage;

// --- Structured data (JSON-LD) ---
const sectionNames: Record<string, string> = {
  blog: 'Blog',
  projects: 'Projects',
  tools: 'Tools',
};
const segments = routeKey === '' ? [] : routeKey.split('/');
const crumbs: Crumb[] = [
  { name: 'Home', url: absoluteUrl() },
  ...segments.map((segment, index) => ({
    name:
      index === segments.length - 1 && segments.length > 1
        ? title.replace(` | ${SITE_CONFIG.author}`, '')
        : (sectionNames[segment] ?? title.replace(` | ${SITE_CONFIG.author}`, '')),
    url: absoluteUrl(`${segments.slice(0, index + 1).join('/')}/`),
  })),
];
const tool = toolsList.find((entry) => routeKey === `tools/${entry.slug}`);
const graph: SchemaNode[] = [];
if (routeKey === '') graph.push(personSchema(), websiteSchema());
else graph.push(breadcrumbSchema(crumbs));
if (tool) graph.push(webAppSchema(tool, canonicalUrl.href, absoluteUrl(ogImage)));
if (schema) graph.push(...[schema].flat());
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>
    // Apply the saved (or system) theme before first paint to avoid a flash.
    (function () {
      var read = function () {
        try { return localStorage.getItem('theme'); } catch (e) { return null; }
      };
      var preferred = function () {
        return read() || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      };
      document.documentElement.dataset.theme = preferred();
      // Keep the theme across Astro view transitions.
      document.addEventListener('astro:before-swap', function (event) {
        event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme;
      });
    })();
  </script>
  <Seo
    title={title}
    description={description}
    canonicalUrl={canonicalUrl.href}
    image={ogImage}
    type={type}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    tags={tags}
    noindex={noindex}
  />
  <script type="application/ld+json" set:html={jsonLd} />
  <meta name="google-site-verification" content="TMBKLG3n0XFX-qsZDiZj1IE8RP4azFETRj5TwL0WsYE" />
  <link rel="sitemap" type="application/xml" href={`${baseUrl}sitemap-index.xml`} />
  <link rel="alternate" type="application/rss+xml" title={`${SITE_CONFIG.author} — Tech Blog`} href={`${baseUrl}rss.xml`} />
  <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
  <title>{title}</title>
  <ClientRouter />
</head>
<body>
  <div class="site-wrapper">
    <img src={`${baseUrl}images/flora/floral-corner.webp`} alt="" aria-hidden="true" width="720" height="720" decoding="async" class="flora-decoration flora-decoration-corner" />
    <img src={`${baseUrl}images/flora/floral-left.webp`} alt="" aria-hidden="true" width="480" height="720" loading="lazy" decoding="async" class="flora-decoration flora-decoration-left" />
    <img src={`${baseUrl}images/flora/floral-bloom.webp`} alt="" aria-hidden="true" width="280" height="280" loading="lazy" decoding="async" class="flora-decoration flora-decoration-bloom" />
    <Header activePage={activePage} headerTitle={headerTitle} />
    <main
      class="site-content"
      transition:animate="fade"
      data-pagefind-body={searchable ? '' : undefined}
      data-pagefind-meta={searchable ? `title:${title.replace(` | ${SITE_CONFIG.author}`, '')}` : undefined}
    >
      <slot />
    </main>
    <Footer />
  </div>

  <SearchPalette />

  <!-- Email BOM / Modal -->
  <div id="email-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-box">
      <div class="modal-header">
        <h3 id="modal-title">Contact Jasurbek Haydarov</h3>
        <button id="close-modal-btn" class="modal-close" aria-label="Close modal">&times;</button>
      </div>
      <div class="modal-body">
        <p class="modal-label">Direct Email Address:</p>
        <div class="email-display-card">
          <code id="email-text">jasurhaydarovcode@gmail.com</code>
        </div>
        <div class="modal-actions">
          <button id="copy-email-btn" class="btn">Copy Email</button>
          <a id="mail-app-link" href="mailto:jasurhaydarovcode@gmail.com" class="btn btn-secondary">Open Mail App</a>
        </div>
        <div id="copy-success-msg" class="copy-success" style="display: none;">
          ✓ Email copied to clipboard!
        </div>
      </div>
    </div>
  </div>

  <script>
    function setupEmailModal() {
      const modal = document.getElementById('email-modal');
      const closeBtn = document.getElementById('close-modal-btn');
      const copyBtn = document.getElementById('copy-email-btn');
      const copySuccess = document.getElementById('copy-success-msg');
      const emailTriggers = document.querySelectorAll('.email-trigger');

      if (!modal) return;

      function openModal(e: Event) {
        e.preventDefault();
        modal.style.display = 'flex';
      }

      function closeModal() {
        modal.style.display = 'none';
        if (copySuccess) copySuccess.style.display = 'none';
      }

      emailTriggers.forEach(el => el.addEventListener('click', openModal));
      closeBtn?.addEventListener('click', closeModal);
      
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });

      copyBtn?.addEventListener('click', () => {
        navigator.clipboard.writeText('jasurhaydarovcode@gmail.com');
        if (copySuccess) {
          copySuccess.style.display = 'block';
          setTimeout(() => {
            if (copySuccess) copySuccess.style.display = 'none';
          }, 3000);
        }
      });
    }

    document.addEventListener('astro:page-load', setupEmailModal);

    const THEME_COLORS: Record<string, string> = { light: '#d8cfc0', dark: '#0f1512' };

    function setupThemeToggle() {
      const button = document.getElementById('theme-toggle');
      if (!button) return;

      const sync = () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        button.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
        button.setAttribute('aria-pressed', String(theme === 'dark'));
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', THEME_COLORS[theme]);
      };

      button.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        sync();
      });

      sync();
    }

    document.addEventListener('astro:page-load', setupThemeToggle);
  </script>
</body>
</html>
