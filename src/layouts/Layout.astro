---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE_CONFIG } from '../config';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
  headerTitle?: string;
  /** Site-relative OG image path. Derived from the route when omitted. */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  tags?: string[];
  noindex?: boolean;
}

const { 
  title, 
  description = SITE_CONFIG.description, 
  activePage = '',
  headerTitle,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags,
  noindex = false,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;
const basePath = baseUrl.replace(/\/$/, '');
const pagePath = Astro.url.pathname;
const canonicalPath = pagePath === basePath
  ? baseUrl
  : pagePath.startsWith(`${basePath}/`)
    ? pagePath
    : `${baseUrl}${pagePath.replace(/^\/+/, '')}`;
const canonicalUrl = new URL(canonicalPath, Astro.site);

// Map a route to its generated OG image (see src/pages/og/[...slug].png.ts).
const routeKey = canonicalPath.slice(baseUrl.length).replace(/\/+$/, '');
const knownOgRoutes = ['blog', 'projects', 'tools'];
const derivedImage =
  routeKey === ''
    ? SITE_CONFIG.defaultOgImage
    : knownOgRoutes.includes(routeKey) || /^(blog|tools)\/[^/]+$/.test(routeKey)
      ? `og/${routeKey}.png`
      : SITE_CONFIG.defaultOgImage;
const ogImage = image ?? derivedImage;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <Seo
    title={title}
    description={description}
    canonicalUrl={canonicalUrl.href}
    image={ogImage}
    type={type}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    tags={tags}
    noindex={noindex}
  />
  <meta name="google-site-verification" content="TMBKLG3n0XFX-qsZDiZj1IE8RP4azFETRj5TwL0WsYE" />
  <link rel="sitemap" type="application/xml" href={`${baseUrl}sitemap-index.xml`} />
  <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
  <title>{title}</title>
  <ClientRouter />
</head>
<body>
  <div class="site-wrapper">
    <img src={`${baseUrl}images/flora/floral-corner.png`} alt="" aria-hidden="true" class="flora-decoration flora-decoration-corner" />
    <img src={`${baseUrl}images/flora/floral-left.png`} alt="" aria-hidden="true" class="flora-decoration flora-decoration-left" />
    <img src={`${baseUrl}images/flora/floral-bloom.png`} alt="" aria-hidden="true" class="flora-decoration flora-decoration-bloom" />
    <Header activePage={activePage} headerTitle={headerTitle} />
    <main class="site-content" transition:animate="fade">
      <slot />
    </main>
    <Footer />
  </div>

  <!-- Email BOM / Modal -->
  <div id="email-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-box">
      <div class="modal-header">
        <h3 id="modal-title">Contact Jasurbek Haydarov</h3>
        <button id="close-modal-btn" class="modal-close" aria-label="Close modal">&times;</button>
      </div>
      <div class="modal-body">
        <p style="margin: 0 0 0.5rem; color: #57606a; font-size: 0.92rem;">Direct Email Address:</p>
        <div class="email-display-card">
          <code id="email-text">jasurhaydarovcode@gmail.com</code>
        </div>
        <div class="modal-actions">
          <button id="copy-email-btn" class="btn">Copy Email</button>
          <a id="mail-app-link" href="mailto:jasurhaydarovcode@gmail.com" class="btn btn-secondary">Open Mail App</a>
        </div>
        <div id="copy-success-msg" style="display: none; color: #1a7f37; font-size: 0.85rem; text-align: center; margin-top: 0.75rem; font-weight: 500;">
          ✓ Email copied to clipboard!
        </div>
      </div>
    </div>
  </div>

  <script>
    function setupEmailModal() {
      const modal = document.getElementById('email-modal');
      const closeBtn = document.getElementById('close-modal-btn');
      const copyBtn = document.getElementById('copy-email-btn');
      const copySuccess = document.getElementById('copy-success-msg');
      const emailTriggers = document.querySelectorAll('.email-trigger');

      if (!modal) return;

      function openModal(e: Event) {
        e.preventDefault();
        modal.style.display = 'flex';
      }

      function closeModal() {
        modal.style.display = 'none';
        if (copySuccess) copySuccess.style.display = 'none';
      }

      emailTriggers.forEach(el => el.addEventListener('click', openModal));
      closeBtn?.addEventListener('click', closeModal);
      
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });

      copyBtn?.addEventListener('click', () => {
        navigator.clipboard.writeText('jasurhaydarovcode@gmail.com');
        if (copySuccess) {
          copySuccess.style.display = 'block';
          setTimeout(() => {
            if (copySuccess) copySuccess.style.display = 'none';
          }, 3000);
        }
      });
    }

    document.addEventListener('astro:page-load', setupEmailModal);
  </script>
</body>
</html>
